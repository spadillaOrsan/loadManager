<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>LoadManager</RootNamespace>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>UAAC</ApplicationTitle>
    <ApplicationId>com.companyname.loadmanager</ApplicationId>

    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
      24.0
    </SupportedOSPlatformVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
      10.0.17763.0
    </SupportedOSPlatformVersion>

    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
      10.0.17763.0
    </TargetPlatformMinVersion>

  </PropertyGroup>

  <!-- Android -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">

    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>

    <RuntimeIdentifiers>android-x64;android-arm64;android-arm</RuntimeIdentifiers>

    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

    <AndroidUseApkSigner>true</AndroidUseApkSigner>
    <AndroidUseAapt2>true</AndroidUseAapt2>

    <AndroidStoreUncompressedFileExtensions>resources.arsc</AndroidStoreUncompressedFileExtensions>

  </PropertyGroup>

  <!-- Debug -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">

    <AndroidZipAlign>false</AndroidZipAlign>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

  </PropertyGroup>

  <!-- Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">

    <AndroidZipAlign>true</AndroidZipAlign>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(USERPROFILE)\.android\debug.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>android</AndroidSigningKeyPass>
    <AndroidSigningStorePass>android</AndroidSigningStorePass>

  </PropertyGroup>

  <ItemGroup>

    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" />

    <MauiSplashScreen Include="Resources\Splash\uaac2splash.png" Color="#FFFFFF" BaseSize="360,640" />

    <MauiImage Include="Resources\Images\*" />

    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <MauiFont Include="Resources\Fonts\*" />

    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

    <MauiAsset Include="appsettings.json" LogicalName="appsettings.json" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />

    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="8.0.100" />

    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />

    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />


  </ItemGroup>

</Project>

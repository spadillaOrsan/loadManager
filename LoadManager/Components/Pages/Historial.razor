@page "/historial"
@using System.Globalization
@using System.Net
@inject IGasStationService GasStationService
@inject IJSRuntime JsRuntime
@inject IReceiptPrinterService ReceiptPrinter

<section class="console-shell history-shell @(isLoading ? "is-busy" : string.Empty)" aria-busy="@isLoading">
    <section class="settings-panel history-panel">
        <div class="panel-heading">
            <h2>Historial de cargas</h2>
            <div class="panel-heading-actions">
                <span>@(isLoading ? "Consultando..." : $"{records.Count} registros")</span>
                <button class="btn btn-outline-secondary history-search-button" @onclick="RefreshHistoryAsync" disabled="@isLoading">
                    Refrescar
                </button>
            </div>
        </div>

        <div class="history-search">
            <label class="settings-field">
                <span>Folio</span>
                <input class="form-control"
                       placeholder="Buscar folio"
                       value="@folioSearch"
                       @oninput="OnFolioChanged"
                       disabled="@isLoading" />
            </label>
            <button class="btn btn-primary history-search-button" @onclick="LoadHistoryAsync" disabled="@isLoading">
                Buscar
            </button>
            <button class="btn btn-outline-secondary history-search-button" @onclick="ClearSearchAsync" disabled="@isLoading">
                Limpiar
            </button>
        </div>
    </section>

    <section class="response-panel history-panel">
        @if (isLoading)
        {
            <p class="empty-message">Consultando historial...</p>
        }
        else if (records.Count == 0)
        {
            <p class="empty-message">No se encontraron cargas registradas.</p>
        }
        else
        {
            <div class="history-table-wrap">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Estatus</th>
                            <th>Fecha</th>
                            <th>Disp.</th>
                            <th>Mang.</th>
                            <th>Producto</th>
                            <th>Programado</th>
                            <th>Litros</th>
                            <th>Importe</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in records)
                        {
                            <tr>
                                <td>@record.Sequence</td>
                                <td><span class="history-status @GetStatusClass(record)">@record.Status</span></td>
                                <td>@FormatDate(record.CreatedAt)</td>
                                <td>@record.Dispenser</td>
                                <td>@record.Hose</td>
                                <td>@GetProductText(record)</td>
                                <td>@FormatDecimal(record.ProgrammedAmount)</td>
                                <td>@($"{record.Liters:N2}")</td>
                                <td>@($"${record.Amount:N2}")</td>
                                <td>
                                    <button class="btn btn-outline-secondary history-print-button"
                                            @onclick="() => PrintRecordAsync(record)"
                                            disabled="@isLoading">
                                        Imprimir
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (selectedRecord is not null)
    {
        <section class="ticket-panel history-ticket-preview">
            <div class="ticket-folio">
                <span>Folio</span>
                <strong>@selectedRecord.Sequence</strong>
            </div>

            <div class="ticket-grid">
                <div>
                    <span>Estatus</span>
                    <strong>@selectedRecord.Status</strong>
                </div>
                <div>
                    <span>Fecha</span>
                    <strong>@FormatDate(selectedRecord.CreatedAt)</strong>
                </div>
                <div>
                    <span>Dispensario</span>
                    <strong>#@selectedRecord.Dispenser</strong>
                </div>
                <div>
                    <span>Manguera</span>
                    <strong>@selectedRecord.Hose</strong>
                </div>
                <div>
                    <span>Producto</span>
                    <strong>@GetProductText(selectedRecord)</strong>
                </div>
                <div>
                    <span>Tipo</span>
                    <strong>@selectedRecord.DispatchTypeId</strong>
                </div>
                <div>
                    <span>Cantidad</span>
                    <strong>@FormatDecimal(selectedRecord.ProgrammedAmount)</strong>
                </div>
                <div>
                    <span>Precio</span>
                    <strong>@($"${selectedRecord.Price:N2}")</strong>
                </div>
                <div>
                    <span>Litros</span>
                    <strong>@($"{selectedRecord.Liters:N2} Lt")</strong>
                </div>
                <div>
                    <span>Importe</span>
                    <strong>@($"${selectedRecord.Amount:N2}")</strong>
                </div>
            </div>

            <div class="ticket-actions">
                <button class="btn btn-primary action-button" @onclick="PrintSelectedTicketAsync" disabled="@isLoading">
                    Imprimir ticket
                </button>
            </div>
        </section>
    }
</section>

@if (isLoading)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert" role="alertdialog" aria-modal="true" aria-live="assertive">
            <span class="loading-spinner" aria-hidden="true"></span>
            <h2>Consultando registros</h2>
            <p>Espere un momento...</p>
            <span>La pantalla permanecera bloqueada hasta terminar la consulta.</span>
        </section>
    </div>
}

@code {
    private readonly CultureInfo culture = CultureInfo.GetCultureInfo("es-MX");
    private List<DispatchHistoryRecord> records = [];
    private DispatchHistoryRecord? selectedRecord;
    private string folioSearch = string.Empty;
    private bool isLoading;

    private int AuthorizedCount => records.Count(record => !record.IsCanceled);
    private int CanceledCount => records.Count(record => record.IsCanceled);
    private int ClosedCount => records.Count(record => record.IsClosed);

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        isLoading = true;
        selectedRecord = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            records = (await GasStationService.GetDispatchHistoryAsync(folioSearch)).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshHistoryAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task ClearSearchAsync()
    {
        folioSearch = string.Empty;
        await LoadHistoryAsync();
    }

    private void OnFolioChanged(ChangeEventArgs args)
    {
        folioSearch = Convert.ToString(args.Value) ?? string.Empty;
    }

    private async Task PrintRecordAsync(DispatchHistoryRecord record)
    {
        selectedRecord = record;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await PrintSelectedTicketAsync();
    }

    private async Task PrintSelectedTicketAsync()
    {
        if (selectedRecord is null)
        {
            return;
        }

        await ReceiptPrinter.PrintHtmlAsync(BuildTicketHtml(selectedRecord), $"Ticket_{selectedRecord.Sequence}");
    }

    private string BuildTicketHtml(DispatchHistoryRecord record)
    {
        static string Encode(string value) => WebUtility.HtmlEncode(value);

        var printedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss", culture);
        var saleDate = FormatDate(record.CreatedAt);
        var product = GetProductText(record);

        return "<!doctype html><html><head><meta charset=\"utf-8\">" +
            "<style>" +
            "body{color:#111;font-family:'Courier New',monospace;margin:0;padding:10px;font-size:13px;font-weight:700;}" +
            ".ticket{width:100%;max-width:280px;margin:0 auto;}" +
            ".center{text-align:center;}" +
            ".brand{font-size:14px;letter-spacing:.08em;margin-bottom:2px;}" +
            ".title{font-size:13px;letter-spacing:.08em;margin-bottom:8px;}" +
            ".line{border-top:1px dashed #111;margin:8px 0;}" +
            ".folio-code{font-size:15px;letter-spacing:.04em;margin:7px 0;}" +
            ".row{display:flex;justify-content:space-between;gap:8px;line-height:1.45;}" +
            ".row span:first-child{white-space:nowrap;}" +
            ".row strong{text-align:right;}" +
            ".section-title{text-align:center;letter-spacing:.08em;margin:8px 0 6px;}" +
            ".product{font-size:14px;margin:8px 0 5px;}" +
            ".print-date{margin-top:18px;text-align:center;}" +
            ".end{margin-top:22px;text-align:center;font-size:15px;letter-spacing:.12em;}" +
            "</style></head><body><section class=\"ticket\">" +
            "<div class=\"center brand\">UAAC</div>" +
            "<div class=\"center title\">ORIGINAL</div>" +
            "<div class=\"line\"></div>" +
            $"<div class=\"center folio-code\">{record.Sequence}</div>" +
            "<div class=\"center\">ADMINISTRADOR DE CARGAS</div>" +
            "<div class=\"line\"></div>" +
            $"<div class=\"row\"><span>Folio :</span><strong>{record.Sequence}</strong></div>" +
            $"<div class=\"row\"><span>Fecha :</span><strong>{Encode(saleDate)}</strong></div>" +
            $"<div class=\"row\"><span>Bomba :</span><strong>{record.Dispenser}</strong></div>" +
            $"<div class=\"row\"><span>Dispensario :</span><strong>{record.Dispenser}</strong></div>" +
            $"<div class=\"row\"><span>Manguera :</span><strong>{record.Hose}</strong></div>" +
            $"<div class=\"row\"><span>Estatus :</span><strong>{Encode(record.Status)}</strong></div>" +
            "<div class=\"section-title\">-------DESPACHO-------</div>" +
            $"<div class=\"product\">{Encode(product)}</div>" +
            $"<div class=\"row\"><span>Tipo</span><strong>{record.DispatchTypeId}</strong></div>" +
            $"<div class=\"row\"><span>Cantidad</span><strong>{Encode(FormatDecimal(record.ProgrammedAmount))}</strong></div>" +
            $"<div class=\"row\"><span>Precio</span><strong>${record.Price:N2}</strong></div>" +
            $"<div class=\"row\"><span>Litros</span><strong>{record.Liters:N2}</strong></div>" +
            $"<div class=\"row\"><span>Importe</span><strong>${record.Amount:N2}</strong></div>" +
            "<div class=\"print-date\">FechaImpresion<br/>" +
            $"{Encode(printedAt)}</div>" +
            "<div class=\"end\">FIN DE TICKET</div>" +
            "</section></body></html>";
    }

    private static string GetStatusClass(DispatchHistoryRecord record)
    {
        if (record.IsCanceled)
        {
            return "is-canceled";
        }

        return record.IsClosed ? "is-closed" : "is-authorized";
    }

    private static string GetProductText(DispatchHistoryRecord record)
    {
        return string.IsNullOrWhiteSpace(record.ProductDescription)
            ? record.Product.ToString()
            : record.ProductDescription;
    }

    private string FormatDate(DateTime? date)
    {
        return date?.ToString("yyyy-MM-dd HH:mm", culture) ?? "Sin fecha";
    }

    private string FormatDecimal(decimal value)
    {
        return value == 0m ? "0.00" : value.ToString("N2", culture);
    }
}

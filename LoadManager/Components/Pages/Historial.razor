@page "/historial"
@using System.Globalization
@using LoadManager.Helpers
@implements IDisposable
@inject IGasStationService GasStationService
@inject IAppSettingsService SettingsProvider
@inject IJSRuntime JsRuntime
@inject IReceiptPrinterService ReceiptPrinter
@inject IConsoleLogService Logger
@inject IDevModeService DevMode
@inject LoadManager.Services.ModuleHeaderState HeaderState

<section class="console-shell history-shell @(isLoading ? "is-busy" : string.Empty)" aria-busy="@isLoading">

    <div class="historial-stage-track stage-@historialStage">

        <!-- Etapa 1: Dispensarios -->
        <section class="historial-dispensers-panel dispatch-stage-card">
            <div class="dispensers-grid">
                @foreach (var d in availableDispensers)
                {
                    <button class="dispenser-card is-checking @(selectedDispenser == d ? "is-selected" : null)"
                            @onclick="() => SelectDispenserAsync(d)"
                            disabled="@isLoading">
                        <img src="images/dispensers/inactivo.png" alt="" />
                        <div class="dispenser-text">
                            <span class="dispenser-number">@dispenserLabel @d.ToString("D2")</span>
                        </div>
                    </button>
                }
            </div>
        </section>

        <!-- Etapa 2: Productos -->
        <section class="historial-products-panel dispatch-stage-card">
            <div class="dispensers-grid">
                @foreach (var p in availableProducts)
                {
                    <button class="dispenser-card is-available @p.CssClass @(selectedProduct == p.Id ? "is-selected" : null)"
                            @onclick="() => SelectProductAsync(p.Id)"
                            disabled="@isLoading">
                        <img src="@p.ImagePath" alt="" />
                        <div class="dispenser-text">
                            <span class="dispenser-number">@p.Description</span>
                        </div>
                    </button>
                }
            </div>
        </section>

        <!-- Etapa 3: Resultados -->
        <section class="historial-results-panel dispatch-stage-card">
            @if (records.Count == 0)
            {
                <div class="historial-empty">
                    <p>No se encontraron registros para este filtro.</p>
                    <button class="btn btn-outline-secondary" @onclick="ResetFilters">
                        Limpiar filtros
                    </button>
                </div>
            }
            else
            {
                <div class="historial-cards">
                    @foreach (var record in records)
                    {
                        <article class="historial-card @GetStatusClass(record)"
                                 role="button"
                                 @onclick="() => OnRecordCardClick(record)">
                            <header class="historial-card-header">
                                <span class="historial-card-folio">Folio #@record.Sequence</span>
                                <span class="history-status @GetStatusClass(record)">@record.Status</span>
                            </header>

                            <div class="historial-card-body">
                                <div class="historial-card-row">
                                    <span>Hora</span>
                                    <strong>@FormatTime(record.CreatedAt)</strong>
                                </div>
                                <div class="historial-card-row">
                                    <span>Cantidad</span>
                                    <strong>$@record.Amount.ToString("N2", culture)</strong>
                                </div>
                                <div class="historial-card-row">
                                    <span>Litros</span>
                                    <strong>@record.Liters.ToString("N3", culture)</strong>
                                </div>
                            </div>

                        </article>
                    }
                </div>
            }
        </section>

    </div>

</section>

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="app-toast @toastCss">@toastMessage</div>
}

@if (isLoading)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert" role="alertdialog" aria-modal="true" aria-live="assertive">
            <span class="loading-spinner" aria-hidden="true"></span>
            <h2>Consultando registros</h2>
            <p>Espere un momento...</p>
            <span>La pantalla permanecera bloqueada hasta terminar la consulta.</span>
        </section>
    </div>
}

@if (showPrintConfirm)
{
    <div class="app-modal-backdrop">
        <section class="app-modal print-confirm-modal" role="dialog" aria-modal="true" aria-label="Confirmar impresion">
            <h2>Imprimir ticket</h2>
            <p>¿Desea imprimir el ticket del folio @printConfirmRecord?.Sequence?</p>
            <div class="dev-password-actions">
                <button class="btn btn-outline-secondary action-button" type="button" @onclick="CancelPrintConfirm">Cancelar</button>
                <button class="btn btn-primary action-button" type="button" @onclick="ConfirmPrintAsync">Imprimir</button>
            </div>
        </section>
    </div>
}

@if (isPrinting)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert" role="alertdialog" aria-modal="true" aria-live="assertive">
            <span class="loading-spinner" aria-hidden="true"></span>
            <h2>Imprimiendo ticket</h2>
            <p>Espere un momento...</p>
            <span>La pantalla permanecera bloqueada hasta terminar la impresion.</span>
        </section>
    </div>
}

@code {
    private readonly CultureInfo culture = CultureInfo.GetCultureInfo("es-MX");

    private int historialStageValue = 1;

    // Propiedad en vez de campo simple: cada cambio de etapa avisa a
    // MainLayout (via HeaderState) para que los iconos y el subtitulo del
    // header (visibles solo en la Etapa 3) aparezcan/desaparezcan.
    private int historialStage
    {
        get => historialStageValue;
        set
        {
            historialStageValue = value;
            HeaderState.Refresh();
        }
    }

    private bool isLoading;
    private bool printEnabled => !DevMode.IsPrintButtonHidden;

    private List<int> availableDispensers = [];
    private List<HistorialProductViewModel> availableProducts = [];

    private int selectedDispenser;
    private int selectedProduct;

    private int historialTop = 3;
    private string dispenserLabel = "Dispensario";
    private AppConfigurationOptions productNameConfig = new();

    private string SelectedProductDescription =>
        availableProducts.FirstOrDefault(p => p.Id == selectedProduct)?.Description ?? selectedProduct.ToString();

    private List<DispatchHistoryRecord> records = [];

    private string? toastMessage;
    private string toastCss = "is-success";

    protected override async Task OnInitializedAsync()
    {
        HeaderState.SetActions(HistorialHeaderActions);
        HeaderState.SetSubtitle(HistorialHeaderSubtitle);
        await LoadInitialDataAsync();
    }

    public void Dispose()
    {
        HeaderState.SetActions(null);
        HeaderState.SetSubtitle(null);
    }

    // Iconos de Refrescar, Atras y Reiniciar, dibujados por MainLayout a la
    // misma altura que el titulo "Historial", del lado derecho. Solo tienen
    // sentido una vez que hay resultados (Etapa 3).
    private RenderFragment HistorialHeaderActions => @<text>
        @if (historialStage >= 3)
        {
            <button class="btn btn-outline-secondary icon-only-button"
                    type="button"
                    title="Refrescar"
                    aria-label="Refrescar"
                    @onclick="RefreshAsync"
                    disabled="@isLoading">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 12a9 9 0 1 1-3-6.7" />
                    <path d="M21 3v6h-6" />
                </svg>
            </button>
            <button class="btn btn-outline-secondary icon-only-button"
                    type="button"
                    title="Atras"
                    aria-label="Atras"
                    @onclick="() => GoToStage(2)"
                    disabled="@isLoading">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="M11 18l-6-6 6-6" />
                </svg>
            </button>
            <button class="btn btn-outline-secondary icon-only-button"
                    type="button"
                    title="Reiniciar"
                    aria-label="Reiniciar"
                    @onclick="ResetFilters"
                    disabled="@isLoading">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2v6" />
                    <path d="M18.36 6.64a9 9 0 1 1-12.73 0" />
                </svg>
            </button>
        }
    </text>;

    // Resumen del filtro activo (dispensario + producto), mostrado por
    // MainLayout debajo del titulo "Historial". Solo aplica en Etapa 3.
    private RenderFragment HistorialHeaderSubtitle => @<text>
        @if (historialStage >= 3)
        {
            <text>Disp. @selectedDispenser &middot; @SelectedProductDescription</text>
        }
    </text>;

    private async Task LoadInitialDataAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var settings = await SettingsProvider.GetSettingsAsync();
            historialTop = settings.AppConfiguration.HistorialTopRecords;
            availableDispensers = GetConfiguredDispenserNumbers(settings.AppConfiguration);
            dispenserLabel = settings.AppConfiguration.DispenserLabel;
            productNameConfig = settings.AppConfiguration;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectDispenserAsync(int dispenser)
    {
        selectedDispenser = dispenser;
        selectedProduct = 0;
        availableProducts.Clear();

        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var hoseData = await GasStationService.GetDispenserProductsAsync(selectedDispenser);
            availableProducts = hoseData
                .Select(h => new HistorialProductViewModel(
                    Id: h.ProductId,
                    Description: ProductNameHelper.ResolveDisplayName(h.Description, productNameConfig),
                    CssClass: FuelProductHelper.GetCssClass(h.Description),
                    ImagePath: FuelProductHelper.GetImagePath(h.Description)))
                .DistinctBy(p => p.Id)
                .ToList();

            if (availableProducts.Count == 0)
            {
                ShowToast($"No se encontraron productos para este {dispenserLabel}.", false);
                return;
            }

            historialStage = 2;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectProductAsync(int product)
    {
        selectedProduct = product;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Logger.WriteAsync(new AppLogEntry
            {
                Level   = "Info",
                Service = nameof(Historial),
                Message = "Busqueda historial iniciada",
                RequestBody = $"Disp={selectedDispenser:D2}; Prod={selectedProduct} ({SelectedProductDescription}); Top={historialTop}"
            });

            records = (await GasStationService.GetHistorialAsync(
                selectedDispenser, selectedProduct, historialTop)).ToList();

            await Logger.WriteAsync(new AppLogEntry
            {
                Level   = records.Count > 0 ? "Success" : "Info",
                Service = nameof(Historial),
                Message = $"Historial: {records.Count} registro(s)",
                RequestBody  = $"Disp={selectedDispenser:D2}; Prod={SelectedProductDescription}",
                ResponseBody = records.Count > 0
                    ? string.Join(" | ", records.Select(r =>
                        $"Sec={r.Sequence} {r.CreatedAt:HH:mm} ${r.Amount:N2} {r.Liters:N3}L [{r.Status}]"))
                    : "Sin registros"
            });

            historialStage = 3;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            records = (await GasStationService.GetHistorialAsync(
                selectedDispenser, selectedProduct, historialTop)).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToStage(int stage)
    {
        historialStage = stage;

        // La seleccion (dispensario/producto) se conserva al regresar para que
        // la tarjeta elegida se vea marcada (contorno neon + palomita), igual
        // que en el despacho. Solo se limpian los datos derivados; al volver a
        // tocar una tarjeta, SelectDispenserAsync/SelectProductAsync recargan.
        if (stage <= 1)
        {
            availableProducts.Clear();
            records.Clear();
        }
        else if (stage == 2)
        {
            records.Clear();
        }
    }

    // Reinicio total: borra los filtros (a diferencia de Volver/Nuevo filtro,
    // que conservan la seleccion marcada) y regresa a la seccion de dispensarios.
    private void ResetFilters()
    {
        selectedDispenser = 0;
        selectedProduct = 0;
        availableProducts.Clear();
        records.Clear();
        historialStage = 1;
    }

    private static List<int> GetConfiguredDispenserNumbers(AppConfigurationOptions cfg)
    {
        if (!cfg.DispenserFillSequential && !string.IsNullOrWhiteSpace(cfg.DispenserNumbers))
        {
            var list = cfg.DispenserNumbers
                .Split(new[] { ',', ';', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(part => int.TryParse(part, out var n) ? n : 0)
                .Where(n => n > 0)
                .Distinct()
                .OrderBy(n => n)
                .ToList();

            if (list.Count > 0)
                return list;
        }

        var count = cfg.DispenserCount > 0 ? cfg.DispenserCount : 4;
        return Enumerable.Range(1, count).ToList();
    }

    private string FormatTime(DateTime? dt) =>
        dt.HasValue ? dt.Value.ToString("HH:mm", culture) : "--:--";

    private string FormatDecimal(decimal value) =>
        value == 0 ? "0" : value.ToString("N2", culture);

    private static string GetStatusClass(DispatchHistoryRecord record)
    {
        if (record.IsCanceled) return "is-canceled";
        return record.IsClosed ? "is-closed" : "is-authorized";
    }

    private void ShowToast(string message, bool success)
    {
        toastMessage = message;
        toastCss = success ? "is-success" : "is-error";
        _ = ClearToastAsync();
    }

    private async Task ClearToastAsync()
    {
        await Task.Delay(3500);
        toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    // La tarjeta completa dispara la impresion (antes lo hacia el boton Imprimir).
    // isPrinting evita que un doble tap registre dos impresiones en tblImpresiones.
    private bool isPrinting;
    private bool showPrintConfirm;
    private DispatchHistoryRecord? printConfirmRecord;

    private void OnRecordCardClick(DispatchHistoryRecord record)
    {
        if (isLoading || isPrinting || !printEnabled)
        {
            return;
        }

        // El mensaje de confirmacion solo aplica a transacciones cerradas (las
        // unicas que realmente se pueden imprimir); para las demas se avisa
        // directo sin preguntar si quiere imprimir.
        if (!record.IsClosed)
        {
            ShowToast("No se pueden imprimir tickets con transaccion abierta.", false);
            return;
        }

        printConfirmRecord = record;
        showPrintConfirm = true;
    }

    private void CancelPrintConfirm()
    {
        showPrintConfirm = false;
        printConfirmRecord = null;
    }

    private async Task ConfirmPrintAsync()
    {
        var record = printConfirmRecord;
        showPrintConfirm = false;
        printConfirmRecord = null;

        if (record is null)
        {
            return;
        }

        isPrinting = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await PrintRecordAsync(record);
        }
        finally
        {
            isPrinting = false;
        }
    }

    private async Task PrintRecordAsync(DispatchHistoryRecord record)
    {
        if (!record.IsClosed)
        {
            ShowToast("No se pueden imprimir tickets con transaccion abierta.", false);
            return;
        }

        await Logger.WriteAsync(new AppLogEntry
        {
            Level   = "Info",
            Service = nameof(Historial),
            Message = "Impresion ticket historial iniciada",
            RequestBody = $"Sec={record.Sequence}; Disp={record.Dispenser:D2}; Mang={record.Hose:D2}; Prod={record.ProductDescription}; Monto=${record.Amount:N2}; Litros={record.Liters:N3}; Estatus={record.Status}"
        });

        try
        {
            int ticketNumber = 0;
            try
            {
                ticketNumber = await GasStationService.RegisterImpressionAsync(record.Sequence);
            }
            catch { }

            // El router decide la ruta: dialogo del sistema o termica Bluetooth ESC/POS.
            var outcome = await ReceiptPrinter.PrintReceiptAsync(record, ticketNumber, $"Ticket_{record.Sequence}");
            if (!outcome.Handled && outcome.Html is not null)
                await JsRuntime.InvokeVoidAsync("uaacPrintHtml", outcome.Html);

            if (!outcome.Success)
            {
                ShowToast(outcome.ErrorMessage ?? "Error al imprimir.", false);
                await Logger.WriteAsync(new AppLogEntry
                {
                    Level     = "Error",
                    Service   = nameof(Historial),
                    Message   = "Error al imprimir ticket.",
                    RequestBody  = $"Sec={record.Sequence}; Ticket#{ticketNumber}",
                    ResponseBody = $"{outcome.Route}: {outcome.ErrorMessage}"
                });
                return;
            }

            await Logger.WriteAsync(new AppLogEntry
            {
                Level   = "Success",
                Service = nameof(Historial),
                Message = "Ticket impreso",
                RequestBody  = $"Sec={record.Sequence}; Ticket#{ticketNumber}",
                ResponseBody = outcome.Handled ? outcome.Route : "Ventana del navegador"
            });
        }
        catch (Exception ex)
        {
            ShowToast("Error al imprimir.", false);
            await Logger.WriteAsync(new AppLogEntry
            {
                Level     = "Error",
                Service   = nameof(Historial),
                Message   = "Error al imprimir ticket.",
                RequestBody  = $"Sec={record.Sequence}; Prod={record.ProductDescription}",
                ResponseBody = ex.ToString()
            });
        }
    }
}

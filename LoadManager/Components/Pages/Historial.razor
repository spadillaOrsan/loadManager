@page "/historial"
@using System.Globalization
@using System.Net
@inject IGasStationService GasStationService
@inject IJSRuntime JsRuntime
@inject IReceiptPrinterService ReceiptPrinter
@inject IConsoleLogService Logger
@inject IDevModeService DevMode

<section class="console-shell history-shell @(isLoading ? "is-busy" : string.Empty)" aria-busy="@isLoading">
    <section class="accordion-section">
        <button class="accordion-header" type="button" @onclick="() => folioFilterOpen = !folioFilterOpen">
            <div class="accordion-title">
                <h2>Filtrar por folio</h2>
            </div>
            <svg class="accordion-chevron @(folioFilterOpen ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
            </svg>
        </button>
        @if (folioFilterOpen)
        {
            <div class="accordion-body">
                <div class="history-search">
                    <label class="settings-field">
                        <span>Folio</span>
                        <input class="form-control"
                               placeholder="Buscar folio"
                               value="@folioSearch"
                               @oninput="OnFolioChanged"
                               disabled="@isLoading" />
                    </label>
                    <button class="btn btn-primary history-search-button" @onclick="LoadHistoryAsync" disabled="@isLoading">
                        Buscar
                    </button>
                    <button class="btn btn-outline-secondary history-search-button" @onclick="ClearSearchAsync" disabled="@isLoading">
                        Limpiar
                    </button>
                </div>
            </div>
        }
    </section>

    <section class="response-panel history-panel">
        @if (isLoading)
        {
            <p class="empty-message">Consultando historial...</p>
        }
        else if (records.Count == 0)
        {
            <p class="empty-message">No se encontraron cargas registradas.</p>
        }
        else
        {

            <div class="panel-heading-actions">
                <div> 
                    <button class="btn btn-outline-secondary history-search-button" @onclick="RefreshHistoryAsync" disabled="@isLoading">
                        Refrescar
                    </button>
                </div>
            </div>
            <div class="history-table-wrap"> 
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Estatus</th>
                            <th>Fecha</th>
                            <th>Disp.</th>
                            <th>Mang.</th>
                            <th>Producto</th>
                            <th>Precio</th>
                            <th>Programado</th>
                            <th>Litros</th>
                            <th>Importe</th>
                            @if (printEnabled)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in records)
                        {
                            <tr>
                                <td>@record.Sequence</td>
                                <td><span class="history-status @GetStatusClass(record)">@record.Status</span></td>
                                <td>@FormatDate(record.CreatedAt)</td>
                                <td>@record.Dispenser</td>
                                <td>@record.Hose</td>
                                <td><span class="product-badge @GetProductBadgeClass(record)">@GetProductText(record)</span></td>
                                <td>@($"${record.Price:N2}")</td>
                                <td>@FormatDecimal(record.ProgrammedAmount)</td>
                                <td>@($"{record.Liters:N2}")</td>
                                <td>@($"${record.Amount:N2}")</td>
                                @if (printEnabled)
                                {
                                    <td>
                                        <button class="btn btn-outline-secondary history-print-button"
                                                @onclick="() => PrintRecordAsync(record)"
                                                disabled="@(isLoading || !record.IsClosed)"
                                                title="@(record.IsClosed ? null : "Solo se puede imprimir una transaccion cerrada")">
                                            Imprimir
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="history-table-footer">@(isLoading ? "Consultando..." : $"{records.Count} registros")</div>
            </div>
        }
    </section>

</section>

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="app-toast @toastCss">@toastMessage</div>
}

@if (isLoading)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert" role="alertdialog" aria-modal="true" aria-live="assertive">
            <span class="loading-spinner" aria-hidden="true"></span>
            <h2>Consultando registros</h2>
            <p>Espere un momento...</p>
            <span>La pantalla permanecera bloqueada hasta terminar la consulta.</span>
        </section>
    </div>
}

@code {
    private readonly CultureInfo culture = CultureInfo.GetCultureInfo("es-MX");
    private List<DispatchHistoryRecord> records = [];
    private string folioSearch = string.Empty;
    private bool isLoading;
    private bool folioFilterOpen;

    // Visible por defecto; se oculta con el toggle "Ocultar boton de impresion" del Modo DEV.
    private bool printEnabled => !DevMode.IsPrintButtonHidden;

    private int AuthorizedCount => records.Count(record => !record.IsCanceled);
    private int CanceledCount => records.Count(record => record.IsCanceled);
    private int ClosedCount => records.Count(record => record.IsClosed);

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            records = (await GasStationService.GetDispatchHistoryAsync(folioSearch)).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshHistoryAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task ClearSearchAsync()
    {
        folioSearch = string.Empty;
        await LoadHistoryAsync();
    }

    private void OnFolioChanged(ChangeEventArgs args)
    {
        folioSearch = Convert.ToString(args.Value) ?? string.Empty;
    }

    private string? toastMessage;
    private string toastCss = "is-success";

    private async Task PrintRecordAsync(DispatchHistoryRecord record)
    {
        // Solo se imprime si la transaccion esta cerrada.
        if (!record.IsClosed)
        {
            ShowToast("No se encontro transaccion o transaccion no cerrada.", false);
            return;
        }

        try
        {
            // Reimpresion: intenta registrar la impresion y obtener el numero de ticket.
            // NO debe bloquear la impresion: si la API no esta disponible, se imprime sin numero.
            var ticketNumber = 0;
            try
            {
                ticketNumber = await GasStationService.RegisterImpressionAsync(record.Sequence);
            }
            catch (Exception impEx)
            {
                await Logger.WriteAsync(new AppLogEntry
                {
                    Level = "Error",
                    Service = "Historial.Imprimir",
                    Message = "No se pudo registrar la impresion en la API (se imprime sin numero de ticket).",
                    RequestBody = $"folio={record.Sequence}",
                    Exception = impEx.ToString()
                });
            }

            var html = TicketHtmlBuilder.Build(record, ticketNumber);

            // Android: dialogo nativo del sistema (PrintManager) con selector de impresora.
            // Windows: el servicio devuelve false y usamos el dialogo del navegador (JS).
            var handled = await ReceiptPrinter.PrintHtmlAsync(html, $"Ticket_{record.Sequence}");
            if (!handled)
            {
                await JsRuntime.InvokeVoidAsync("uaacPrintHtml", html);
            }

            await Logger.WriteAsync(new AppLogEntry
            {
                Level = "Success",
                Service = "Historial.Imprimir",
                Message = $"Ticket enviado a impresion (nativo={handled}, ticket#={ticketNumber}).",
                RequestBody = $"folio={record.Sequence}"
            });
        }
        catch (Exception ex)
        {
            await Logger.WriteAsync(new AppLogEntry
            {
                Level = "Error",
                Service = "Historial.Imprimir",
                Message = "Fallo al imprimir el ticket.",
                RequestBody = $"folio={record.Sequence}",
                Exception = ex.ToString()
            });
            ShowToast($"No se pudo imprimir: {ex.Message}", false);
        }
    }

    private void ShowToast(string message, bool success)
    {
        toastMessage = message;
        toastCss = success ? "is-success" : "is-error";
        _ = ClearToastAsync();
    }

    private async Task ClearToastAsync()
    {
        await Task.Delay(3500);
        toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private static string GetStatusClass(DispatchHistoryRecord record)
    {
        if (record.IsCanceled)
        {
            return "is-canceled";
        }

        return record.IsClosed ? "is-closed" : "is-authorized";
    }

    private static string GetProductText(DispatchHistoryRecord record)
    {
        return string.IsNullOrWhiteSpace(record.ProductDescription)
            ? record.Product.ToString()
            : record.ProductDescription;
    }

    private static string GetProductBadgeClass(DispatchHistoryRecord record)
    {
        var description = GetProductText(record).ToUpperInvariant();

        if (description.Contains("SUPREME") || description.Contains("PREMIUM"))
        {
            return "is-supreme";
        }

        if (description.Contains("DIESEL"))
        {
            return "is-diesel";
        }

        if (description.Contains("MAGNA") || description.Contains("REGULAR") || description.Contains("EXTRA"))
        {
            return "is-magna";
        }

        return "is-default";
    }

    private string FormatDate(DateTime? date)
    {
        return date?.ToString("yyyy-MM-dd HH:mm", culture) ?? "Sin fecha";
    }

    private string FormatDecimal(decimal value)
    {
        return value == 0m ? "0.00" : value.ToString("N2", culture);
    }
}

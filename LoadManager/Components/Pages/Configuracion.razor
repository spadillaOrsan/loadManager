    private async Task RefreshPrinterEndpointsAsync()
    {
        isRefreshingPorts = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var detected = (await BluetoothPrinter.GetPrintersAsync()).ToList();

            // Conserva el destino guardado aunque el dispositivo no este visible ahora,
            // para que el select no pierda la seleccion persistida.
            if (!string.IsNullOrWhiteSpace(printerEndpointId)
                && !detected.Any(endpoint => string.Equals(endpoint.Id, printerEndpointId, StringComparison.OrdinalIgnoreCase)))
            {
                var savedName = printerEndpoints
                    .FirstOrDefault(endpoint => string.Equals(endpoint.Id, printerEndpointId, StringComparison.OrdinalIgnoreCase))
                    ?.DisplayName ?? printerEndpointId;
                detected.Insert(0, new BluetoothPrinterEndpoint { Id = printerEndpointId, DisplayName = savedName });
            }

            printerEndpoints = detected;

            if (printerEndpoints.Count == 0)
            {
                ShowToast(OperatingSystem.IsWindows()
                    ? "No se detectaron puertos COM Bluetooth. Empareje la impresora en Windows."
                    : "No hay impresoras Bluetooth vinculadas. Vincule la impresora en los ajustes de Android.", false);
            }
            else
            {
                ShowToast(printerEndpoints.Count == 1
                    ? $"Se encontro 1 {(OperatingSystem.IsWindows() ? "puerto" : "dispositivo")}."
                    : $"Se encontraron {printerEndpoints.Count} {(OperatingSystem.IsWindows() ? "puertos" : "dispositivos")}.", true);
            }
        }
        catch (Exception ex)
        {
            // Bluetooth apagado o permiso denegado (Android): mensaje claro del servicio.
            ShowToast(ex.Message, false);
        }
        finally
        {
            isRefreshingPorts = false;
        }
    }

    private async Task TestPrinterAsync()
    {
        if (string.IsNullOrWhiteSpace(printerEndpointId))
        {
            ShowToast("Seleccione una impresora Bluetooth.", false);
            return;
        }

        isTestingPort = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var outcome = await BluetoothPrinter.TestAsync(printerEndpointId);
            ShowToast(outcome.Success
                ? $"Conexion correcta con {GetPrinterEndpointName()}."
                : outcome.ErrorMessage ?? $"No se pudo conectar con {GetPrinterEndpointName()}.", outcome.Success);
        }
        catch (Exception)
        {
            // Red de seguridad: SerialPort (Windows) puede lanzar excepciones de bajo
            // nivel (ej. semaforo/timeout de un puerto COM Bluetooth desconectado)
            // fuera del try/catch propio de BluetoothEscPosPrinterService. Sin este
            // catch, el mensaje crudo se filtraba a la UI en vez del toast amigable.
            ShowToast($"No se pudo conectar con {GetPrinterEndpointName()}. Verifique que la impresora este encendida y dentro del alcance Bluetooth.", false);
        }
        finally
        {
            isTestingPort = false;
        }
    }

    private string GetPrinterEndpointName() =>
        printerEndpoints
            .FirstOrDefault(endpoint => string.Equals(endpoint.Id, printerEndpointId, StringComparison.OrdinalIgnoreCase))
            ?.DisplayName ?? printerEndpointId;

    private string GetPrinterIndicatorText()
    {
        if (printerMode == PrinterOptions.ModeBluetoothCom)
        {
            return $"Bluetooth · {(string.IsNullOrWhiteSpace(printerEndpointId) ? "sin dispositivo" : GetPrinterEndpointName())}";
        }

        return OperatingSystem.IsWindows() ? "Windows" : "Sistema (Android)";
    }

    private static List<int> ParseDispenserNumbers(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new List<int>();
        }

        return raw
            .Split(new[] { ',', ';', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(part => int.TryParse(part, out var number) ? number : 0)
            .Where(number => number > 0)
            .Distinct()
            .ToList();
    }

    private async Task<bool> SaveConfigurationOnlyAsync()
    {
        if (settings is null || string.IsNullOrWhiteSpace(ipAddress) || port is <= 0 or > 65535)
        {
            ShowToast("Capture una IP y puerto validos.", false);
            return false;
        }

        if (string.IsNullOrWhiteSpace(apiBaseHost) || apiPort is <= 0 or > 65535)
        {
            ShowToast("Capture un host y puerto validos para la API.", false);
            return false;
        }

        var apiUrl = BuildApiUrl();
        if (!Uri.TryCreate(apiUrl, UriKind.Absolute, out var apiUri)
            || (apiUri.Scheme != Uri.UriSchemeHttp && apiUri.Scheme != Uri.UriSchemeHttps))
        {
            ShowToast("Capture una URL valida para LoadManagerApi.", false);
            return false;
        }

        if (tpv <= 0 || usuario <= 0 || tipoVenta <= 0
            || string.IsNullOrWhiteSpace(tipoInterfaz)
            || string.IsNullOrWhiteSpace(dispenserLabel)
            || limiteImporte <= 0 || limiteLitros <= 0 || cantidadTanqueLleno <= 0
            || quantityDecimals is < 0 or > 6
            || (DevMode.ShouldShowCountdown && authorizationCountdownSeconds <= 0)
            || historialTopRecords is < 3 or > 15
            || apiRequestTimeoutSeconds <= 0)
        {
            ShowToast("Revise los valores de configuracion.", false);
            return false;
        }

        if (printerMode == PrinterOptions.ModeBluetoothCom)
        {
            if (string.IsNullOrWhiteSpace(printerEndpointId))
            {
                ShowToast(OperatingSystem.IsWindows()
                    ? "Seleccione el puerto COM Bluetooth de la impresora."
                    : "Seleccione la impresora Bluetooth vinculada.", false);
                return false;
            }

            if (OperatingSystem.IsWindows() && printerBaudRate <= 0)
            {
                ShowToast("Capture un BaudRate valido (ej. 115200).", false);
                return false;
            }
        }

        var dispenserNumberList = ParseDispenserNumbers(dispenserNumbers);
        if (dispenserFillSequential ? dispenserCount <= 0 : dispenserNumberList.Count == 0)
        {
            ShowToast(dispenserFillSequential
                ? $"Capture una cantidad de {dispenserLabel} mayor a 0."
                : $"Capture numeros de {dispenserLabel} validos (ej. 2,4,6,20,13).", false);
            return false;
        }

        settings.GasStationConsole.IpAddress = ipAddress.Trim();
        settings.GasStationConsole.Port = port;
        settings.AppConfiguration.Tpv = tpv;
        settings.AppConfiguration.Usuario = usuario;
        settings.AppConfiguration.TipoVenta = tipoVenta;
        settings.AppConfiguration.TipoInterfaz = tipoInterfaz.Trim();
        settings.AppConfiguration.DispenserLabel = dispenserLabel.Trim();
        settings.AppConfiguration.UseCustomProductNames = useCustomProductNames;
        settings.AppConfiguration.ProductNameOverrides = new Dictionary<string, string>(productNameOverrides);
        settings.AppConfiguration.LimiteImporte = limiteImporte;
        settings.AppConfiguration.LimiteLitros = limiteLitros;
        settings.AppConfiguration.CantidadTanqueLleno = cantidadTanqueLleno;
        settings.AppConfiguration.QuantityDecimals = quantityDecimals;
        settings.AppConfiguration.AuthorizationCountdownSeconds = authorizationCountdownSeconds;
        settings.AppConfiguration.HistorialTopRecords = Math.Clamp(historialTopRecords, 3, 15);
        settings.AppConfiguration.DispenserFillSequential = dispenserFillSequential;
        settings.AppConfiguration.DispenserNumbers = dispenserFillSequential
            ? string.Empty
            : string.Join(",", dispenserNumberList);
        settings.AppConfiguration.DispenserCount = dispenserCount > 0
            ? dispenserCount
            : Math.Max(1, dispenserNumberList.Count);
        settings.Api.BaseUrl = apiUrl;
        settings.Api.RequestTimeoutSeconds = apiRequestTimeoutSeconds;
        settings.Printer.Mode = printerMode;
        if (OperatingSystem.IsWindows())
        {
            settings.Printer.ComPort = printerEndpointId.Trim();
        }
        else
        {
            settings.Printer.BluetoothAddress = printerEndpointId.Trim();
            settings.Printer.BluetoothName = GetPrinterEndpointName();
        }
        settings.Printer.BaudRate = printerBaudRate > 0 ? printerBaudRate : 115200;
        settings.Printer.PaperColumns = Math.Clamp(printerPaperColumns, 16, 64);

        await SettingsProvider.SaveSettingsAsync(settings);
        return true;
    }


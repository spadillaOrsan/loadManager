@page "/configuracion"
@using LoadManager.Helpers
@inject IAppSettingsService SettingsProvider
@inject IGasStationService ConsoleClient
@inject IConnectionValidationService ConnectionState
@inject IDevModeService DevMode
@inject IBluetoothEscPosPrinterService BluetoothPrinter
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<PageTitle>Configuracion</PageTitle>

<section class="console-shell config-shell">
    <header class="console-header">
        <div>
            <h1>Configuracion</h1>
        </div>
    </header>

    <div class="accordion-list">

        <!-- Interfaz TCP/IP -->
        <section class="accordion-section">
            <button class="accordion-header" type="button" @onclick="() => ToggleSection(0)">
                <div class="accordion-title">
                    <h2>Interfaz TCP/IP</h2>
                    <span class="@GetTcpIndicatorClass()">@GetTcpIndicatorText()</span>
                </div>
                <svg class="accordion-chevron @(openSections[0] ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
            @if (openSections[0])
            {
                <div class="accordion-body">
                    <label class="settings-field">
                        <span>IP destino</span>
                        <input type="text" @bind="ipAddress" placeholder="Ej: 172.20.11.40" />
                    </label>
                    <label class="settings-field">
                        <span>Puerto</span>
                        <input type="number" @bind="port" min="1" max="65535" placeholder="Ej: 8005" />
                    </label>
                </div>
            }
        </section>

        <!-- URL Service -->
        <section class="accordion-section">
            <button class="accordion-header" type="button" @onclick="() => ToggleSection(1)">
                <div class="accordion-title">
                    <h2>URL Service</h2>
                    <span class="@GetDatabaseIndicatorClass()">@GetDatabaseIndicatorText()</span>
                </div>
                <svg class="accordion-chevron @(openSections[1] ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
            @if (openSections[1])
            {
                <div class="accordion-body">
                    <label class="settings-field">
                        <span>Host / URL base</span>
                        <input type="text" @bind="apiBaseHost" placeholder="Ej: http://172.20.11.198" />
                    </label>
                    <label class="settings-field">
                        <span>Puerto API</span>
                        <input type="number" @bind="apiPort" min="1" max="65535" placeholder="Ej: 5047" />
                    </label>
                    <label class="settings-field">
                        <span>Tiempo de espera (seg)</span>
                        <input type="number" @bind="apiRequestTimeoutSeconds" min="1" />
                    </label>
                </div>
            }
        </section>

        <!-- URL de APIs -->
        <section class="accordion-section">
            <button class="accordion-header" type="button" @onclick="() => ToggleSection(2)">
                <div class="accordion-title">
                    <h2>URL de APIs</h2>
                    <span class="status-indicator">@BuildApiUrl()</span>
                </div>
                <svg class="accordion-chevron @(openSections[2] ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
            @if (openSections[2])
            {
                <div class="accordion-body">
                    <label class="settings-field">
                        <span>URL completa</span>
                        <input type="text" @bind="ApiFullUrl" placeholder="Ej: http://172.20.11.40:8084/" />
                    </label>
                </div>
            }
        </section>

        <!-- App Configuracion -->
        <section class="accordion-section">
            <button class="accordion-header" type="button" @onclick="() => ToggleSection(3)">
                <div class="accordion-title">
                    <h2>App Configuracion</h2>
                    <span>Datos generales</span>
                </div>
                <svg class="accordion-chevron @(openSections[3] ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
            @if (openSections[3])
            {
                <div class="accordion-body">
                    <label class="settings-field">
                        <span>TPV</span>
                        <input type="number" @bind="tpv" min="1" />
                    </label>
                    <label class="settings-field">
                        <span>Usuario</span>
                        <input type="number" @bind="usuario" min="1" />
                    </label>
                    <label class="settings-field">
                        <span>Tipo de venta</span>
                        <input type="number" @bind="tipoVenta" min="1" />
                    </label>
                    <label class="settings-field">
                        <span>Tipo de interfaz</span>
                        <input type="text" @bind="tipoInterfaz" />
                    </label>
                    <label class="settings-field">
                        <span>Limite de importe</span>
                        <input type="number" @bind="limiteImporte" min="0.01" step="0.01" />
                    </label>
                    <label class="settings-field">
                        <span>Limite de litros</span>
                        <input type="number" @bind="limiteLitros" min="0.01" step="0.01" />
                    </label>
                    <label class="settings-field">
                        <span>Cantidad para tanque lleno</span>
                        <input type="number" @bind="cantidadTanqueLleno" min="0.01" step="0.01" />
                    </label>
                    <label class="settings-field">
                        <span>Decimales de cantidad</span>
                        <input type="number" @bind="quantityDecimals" min="0" max="6" />
                    </label>
                    @if (DevMode.ShouldShowCountdown)
                    {
                        <label class="settings-field">
                            <span>Tiempo descolgar manguera (seg)</span>
                            <input type="number" @bind="authorizationCountdownSeconds" min="1" />
                        </label>
                    }
                    <label class="settings-field">
                        <span>Registros en historial (3–15)</span>
                        <input type="number" @bind="historialTopRecords" min="3" max="15" />
                    </label>
                    <label class="settings-field">
                        <span>Nombre del dispensario</span>
                        <input type="text" @bind="dispenserLabel" placeholder="Ej: Dispensario, Isla, Bomba" />
                    </label>
                    <div class="settings-field">
                        <div class="settings-field-head">
                            <span>#@DispenserLabelOrDefault</span>
                            <span class="switch-inline">
                                <span class="switch-inline-label">Rellenar</span>
                                <button type="button"
                                        class="switch @(dispenserFillSequential ? "is-on" : string.Empty)"
                                        @onclick="() => dispenserFillSequential = !dispenserFillSequential"
                                        aria-pressed="@dispenserFillSequential"
                                        aria-label="Rellenar secuencial">
                                    <span class="switch-track"><span class="switch-thumb"></span></span>
                                </button>
                            </span>
                        </div>
                        @if (dispenserFillSequential)
                        {
                            <input type="number" @bind="dispenserCount" min="1" placeholder="Ej: 10 (genera 1, 2, ... 10)" />
                        }
                        else
                        {
                            <input type="text" @bind="dispenserNumbers" placeholder="Numeros especificos. Ej: 2,4,6,20,13" />
                        }
                    </div>

                    <div class="settings-field">
                        <div class="settings-field-head">
                            <span>Usar nombres personalizados de producto</span>
                            <span class="switch-inline">
                                <button type="button"
                                        class="switch @(useCustomProductNames ? "is-on" : string.Empty)"
                                        @onclick="ToggleUseCustomProductNamesAsync"
                                        aria-pressed="@useCustomProductNames"
                                        aria-label="Usar nombres personalizados de producto">
                                    <span class="switch-track"><span class="switch-thumb"></span></span>
                                </button>
                            </span>
                        </div>
                    </div>

                    @if (useCustomProductNames)
                    {
                        @if (productCatalog.Count == 0)
                        {
                            <p class="empty-message">
                                @(isLoadingProductCatalog ? "Consultando productos..." : "No se encontraron productos activos.")
                            </p>
                        }
                        else
                        {
                            @foreach (var product in productCatalog)
                            {
                                <label class="settings-field">
                                    <span>@product.Description</span>
                                    <input type="text"
                                           value="@GetProductOverride(product.Description)"
                                           @oninput="e => SetProductOverride(product.Description, e.Value?.ToString() ?? string.Empty)"
                                           placeholder="@product.Description" />
                                </label>
                            }
                        }

                        <div class="settings-actions">
                            <button class="btn btn-outline-secondary action-button" type="button"
                                    @onclick="LoadProductCatalogAsync" disabled="@isLoadingProductCatalog">
                                @(isLoadingProductCatalog ? "Buscando..." : "Actualizar productos")
                            </button>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- Impresora -->
        <section class="accordion-section">
            <button class="accordion-header" type="button" @onclick="() => ToggleSection(4)">
                <div class="accordion-title">
                    <h2>Impresora</h2>
                    <span class="status-indicator">@GetPrinterIndicatorText()</span>
                </div>
                <svg class="accordion-chevron @(openSections[4] ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
            @if (openSections[4])
            {
                <div class="accordion-body">
                    <label class="settings-field">
                        <span>Tipo de impresora</span>
                        <select @bind="printerMode" @bind:after="OnPrinterModeChangedAsync">
                            <option value="@PrinterOptions.ModeWindows">
                                @(OperatingSystem.IsWindows() ? "Impresora de Windows (dialogo del sistema)" : "Dialogo de impresion de Android")
                            </option>
                            <option value="@PrinterOptions.ModeBluetoothCom">
                                @(OperatingSystem.IsWindows() ? "Termica Bluetooth (puerto COM)" : "Termica Bluetooth (vinculada)")
                            </option>
                        </select>
                    </label>

                    @if (printerMode == PrinterOptions.ModeBluetoothCom)
                    {
                        <label class="settings-field">
                            <span>@(OperatingSystem.IsWindows() ? "Puerto COM Bluetooth" : "Impresora Bluetooth vinculada")</span>
                            <select @bind="printerEndpointId">
                                <option value="">@(printerEndpoints.Count == 0 ? "(sin dispositivos detectados)" : "Seleccione...")</option>
                                @foreach (var endpoint in printerEndpoints)
                                {
                                    <option value="@endpoint.Id">@endpoint.DisplayName</option>
                                }
                            </select>
                        </label>
                        @if (OperatingSystem.IsWindows())
                        {
                            <label class="settings-field">
                                <span>BaudRate</span>
                                <input type="number" @bind="printerBaudRate" min="1200" placeholder="Ej: 115200" />
                            </label>
                        }
                        <label class="settings-field">
                            <span>Columnas de papel (32 = 58mm, 48 = 80mm)</span>
                            <input type="number" @bind="printerPaperColumns" min="16" max="64" />
                        </label>
                        <div class="settings-actions">
                            <button class="btn btn-outline-secondary action-button" type="button"
                                    @onclick="RefreshPrinterEndpointsAsync" disabled="@IsPrinterBusy">
                                @(isRefreshingPorts ? "Buscando..." : (OperatingSystem.IsWindows() ? "Actualizar puertos" : "Actualizar dispositivos"))
                            </button>
                            <button class="btn btn-outline-secondary action-button" type="button"
                                    @onclick="TestPrinterAsync" disabled="@IsPrinterBusy">
                                @(isTestingPort ? "Probando..." : "Probar conexion")
                            </button>
                        </div>
                    }
                </div>
            }
        </section>

    </div>

    <!-- Modo DEV (desarrollo): desactiva validaciones del modulo de dispensario.
         Se activa tocando 10 veces el apartado DEV (luego pide contrasena). -->
    <section class="dev-section">
        <div class="dev-section-head">
            <div class="dev-section-title dev-tap-area" @onclick="OnDevTap" role="button" tabindex="0">
                <h5 style="text-align:center;">Version: 1.0.0</h5>
            </div>
            @if (DevMode.IsEnabled)
            {
                <button type="button" class="btn btn-outline-secondary dev-disable-button" @onclick="DisableDev">
                    Desactivar
                </button>
            }
        </div>

        @if (DevMode.IsEnabled)
        {
            <div class="dev-toggle-list">
                <p class="dev-warning">Validaciones desactivadas: las pantallas usaran datos de ejemplo. No usar en produccion.</p>

                <div class="switch-row dev-toggle-all">
                    <span class="switch-row-label">@(AreAllDevTogglesOn ? "Desactivar todo" : "Activar todo")</span>
                    <button type="button"
                            class="switch @(AreAllDevTogglesOn ? "is-on" : string.Empty)"
                            @onclick="ToggleAllDevToggles"
                            aria-pressed="@AreAllDevTogglesOn"
                            aria-label="Activar o desactivar todos los toggles">
                        <span class="switch-track"><span class="switch-thumb"></span></span>
                    </button>
                </div>

                @foreach (var toggle in DevToggles)
                {
                    <div class="switch-row">
                        <span class="switch-row-label">@toggle.Label</span>
                        <button type="button"
                                class="switch @(toggle.Get() ? "is-on" : string.Empty)"
                                @onclick="() => toggle.Set(!toggle.Get())"
                                aria-pressed="@toggle.Get()">
                            <span class="switch-track"><span class="switch-thumb"></span></span>
                        </button>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Botones al fondo -->
    <div class="settings-actions config-actions-footer">
        <button class="btn btn-outline-secondary action-button" type="button" @onclick="OpenTester" disabled="@isSaving">
            Tester
        </button>
        <button class="@GetConnectionButtonClass()" @onclick="SaveConnectOrDisconnectAsync" disabled="@isSaving">
            @GetConnectionButtonText()
        </button>
    </div>
</section>

<button class="scroll-top-button" type="button" @onclick="ScrollToTopAsync"
        title="Subir arriba" aria-label="Subir arriba">
    <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 19V5" />
        <path d="M5 12l7-7 7 7" />
    </svg>
</button>

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="app-toast @toastCss">@toastMessage</div>
}

@if (showDevPasswordModal)
{
    <div class="app-modal-backdrop">
        <section class="app-modal dev-password-modal" role="dialog" aria-modal="true" aria-label="Contraseña DEV">
            <h2>Modo DEV</h2>
            <p>Ingrese la contraseña para desactivar validaciones.</p>
            <input type="password"
                   class="dev-password-input"
                   placeholder="Contraseña"
                   @bind="devPassword"
                   @bind:event="oninput"
                   @onkeydown="OnDevPasswordKeyDown" />
            @if (!string.IsNullOrEmpty(devPasswordError))
            {
                <span class="dev-password-error">@devPasswordError</span>
            }
            <div class="dev-password-actions">
                <button class="btn btn-outline-secondary action-button" type="button" @onclick="CancelDevPassword">Cancelar</button>
                <button class="btn btn-primary action-button" type="button" @onclick="ConfirmDevPassword">Activar</button>
            </div>
        </section>
    </div>
}

@code {
    private AppSettings? settings;
    private string ipAddress = string.Empty;
    private int port;
    private int tpv;
    private int usuario;
    private int tipoVenta;
    private string tipoInterfaz = string.Empty;
    private decimal limiteImporte;
    private decimal limiteLitros;
    private decimal cantidadTanqueLleno;
    private int quantityDecimals;
    private int authorizationCountdownSeconds;
    private int historialTopRecords;
    private int dispenserCount;
    private bool dispenserFillSequential = true;
    private string dispenserNumbers = string.Empty;
    private string dispenserLabel = string.Empty;

    private string DispenserLabelOrDefault =>
        string.IsNullOrWhiteSpace(dispenserLabel) ? "Dispensario" : dispenserLabel;

    private bool useCustomProductNames;
    private Dictionary<string, string> productNameOverrides = new();
    private List<DispatchTypeOption> productCatalog = [];
    private bool isLoadingProductCatalog;

    private string apiBaseHost = string.Empty;
    private int apiPort;
    private int apiRequestTimeoutSeconds;
    private int toastDurationMilliseconds;
    private bool isSaving;
    private string connectionStatus = "Sin validar";
    private string databaseStatus = "Sin validar";
    private bool? databaseIsConnected;
    private string? toastMessage;
    private string toastCss = "is-success";

    private readonly bool[] openSections = [false, false, false, false, false];

    // --- Impresora ---
    // printerEndpointId: puerto COM en Windows, direccion MAC en Android.
    private string printerMode = PrinterOptions.ModeWindows;
    private string printerEndpointId = string.Empty;
    private int printerBaudRate = 115200;
    private int printerPaperColumns = 32;
    private List<BluetoothPrinterEndpoint> printerEndpoints = [];
    private bool isRefreshingPorts;
    private bool isTestingPort;

    private bool IsPrinterBusy => isRefreshingPorts || isTestingPort || isSaving;

    private string ApiFullUrl
    {
        get => BuildApiUrl();
        set => ParseApiUrl(value);
    }

    private void ToggleSection(int index) => openSections[index] = !openSections[index];

    // --- Modo DEV ---
    private bool showDevPasswordModal;
    private string devPassword = string.Empty;
    private string? devPasswordError;

    private List<(string Label, Func<bool> Get, Action<bool> Set)> DevToggles => new()
    {
        ("Saltar conexion TCP/IP", () => DevMode.SkipTcpConnection, v => DevMode.SkipTcpConnection = v),
        ("Saltar base de datos (BD)", () => DevMode.SkipDatabase, v => DevMode.SkipDatabase = v),
        // ("Saltar autorizacion del equipo", () => DevMode.SkipDeviceAuthorization, v => DevMode.SkipDeviceAuthorization = v),
        ($"Saltar comunicacion de {DispenserLabelOrDefault}", () => DevMode.SkipDispenserCommunication, v => DevMode.SkipDispenserCommunication = v),
        ("Saltar tipos de despacho y productos", () => DevMode.SkipDispatchTypesAndProducts, v => DevMode.SkipDispatchTypesAndProducts = v),
        ("Saltar registro/envio de autorizacion", () => DevMode.SkipSendAuthorization, v => DevMode.SkipSendAuthorization = v),
        ("Tratar respuesta de consola como autorizada", () => DevMode.SkipAuthorizationResponse, v => DevMode.SkipAuthorizationResponse = v),
        ("Ignorar bloqueo por manguera descolgada", () => DevMode.SkipHoseLiftedBlock, v => DevMode.SkipHoseLiftedBlock = v),
        ("Ignorar limites de importe/litros", () => DevMode.SkipAmountLimits, v => DevMode.SkipAmountLimits = v),
        ("Simular surtido (ver contador y tanque)", () => DevMode.SimulateFueling, v => DevMode.SimulateFueling = v),
        ("Mostrar contador de litros/moneda al surtir", () => DevMode.ShowLiveCounter, v => DevMode.ShowLiveCounter = v),
        ("Ocultar boton de impresion (historial y ticket)", () => DevMode.HidePrintButton, v => DevMode.HidePrintButton = v),
        ("Cancelar carga al pasar a segundo plano", () => DevMode.CancelOnBackground, v => DevMode.CancelOnBackground = v),
        ("Contador en autorizacion", () => DevMode.UseCountdown, v => DevMode.UseCountdown = v),
    };

    private bool AreAllDevTogglesOn => DevToggles.All(toggle => toggle.Get());

    private void ToggleAllDevToggles()
    {
        var target = !AreAllDevTogglesOn;
        foreach (var toggle in DevToggles)
        {
            toggle.Set(target);
        }
    }

    private int devTapCount;

    // Se activa el Modo DEV tocando 10 veces el apartado (estilo "opciones de desarrollador").
    private void OnDevTap()
    {
        if (DevMode.IsEnabled)
        {
            return;
        }

        devTapCount++;

        if (devTapCount >= 10)
        {
            devTapCount = 0;
            devPassword = string.Empty;
            devPasswordError = null;
            showDevPasswordModal = true;
        }
    }

    private void DisableDev()
    {
        DevMode.Disable();
        devTapCount = 0;
    }

    private void ConfirmDevPassword()
    {
        if (!AppSettingsCryptoHelper.VerifyDevModePassword(devPassword))
        {
            devPasswordError = "Contraseña incorrecta.";
            return;
        }

        DevMode.IsEnabled = true;
        showDevPasswordModal = false;
        devPassword = string.Empty;
        devPasswordError = null;
    }

    private void CancelDevPassword()
    {
        showDevPasswordModal = false;
        devPassword = string.Empty;
        devPasswordError = null;
    }

    private void OnDevPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ConfirmDevPassword();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var current = await SettingsProvider.GetSettingsAsync();
        settings = new AppSettings
        {
            GasStationConsole = new GasStationConsoleOptions
            {
                IpAddress = current.GasStationConsole.IpAddress,
                Port = current.GasStationConsole.Port,
                ConnectionTimeoutMilliseconds = current.GasStationConsole.ConnectionTimeoutMilliseconds,
                ReadTimeoutMilliseconds = current.GasStationConsole.ReadTimeoutMilliseconds,
                ReceiveBufferSize = current.GasStationConsole.ReceiveBufferSize,
                MaxSendAttempts = current.GasStationConsole.MaxSendAttempts,
                EncodingName = current.GasStationConsole.EncodingName,
                Commands = new Dictionary<string, string>(current.GasStationConsole.Commands)
            },
            AppConfiguration = new AppConfigurationOptions
            {
                Tpv = current.AppConfiguration.Tpv,
                Usuario = current.AppConfiguration.Usuario,
                TipoVenta = current.AppConfiguration.TipoVenta,
                TipoInterfaz = current.AppConfiguration.TipoInterfaz,
                LimiteImporte = current.AppConfiguration.LimiteImporte,
                LimiteLitros = current.AppConfiguration.LimiteLitros,
                CantidadTanqueLleno = current.AppConfiguration.CantidadTanqueLleno,
                QuantityDecimals = current.AppConfiguration.QuantityDecimals,
                AuthorizationCountdownSeconds = current.AppConfiguration.AuthorizationCountdownSeconds,
                AuthorizationWarningSeconds = current.AppConfiguration.AuthorizationWarningSeconds,
                AuthorizationPollingMilliseconds = current.AppConfiguration.AuthorizationPollingMilliseconds,
                FuelingPollingMilliseconds = current.AppConfiguration.FuelingPollingMilliseconds,
                HoseRestorePollingMilliseconds = current.AppConfiguration.HoseRestorePollingMilliseconds,
                ToastDurationMilliseconds = current.AppConfiguration.ToastDurationMilliseconds,
                DispenserCount = current.AppConfiguration.DispenserCount,
                DispenserFillSequential = current.AppConfiguration.DispenserFillSequential,
                DispenserNumbers = current.AppConfiguration.DispenserNumbers,
                ConfigurationPasswordHash = current.AppConfiguration.ConfigurationPasswordHash,
                HistorialTopRecords = current.AppConfiguration.HistorialTopRecords,
                DispenserLabel = current.AppConfiguration.DispenserLabel,
                UseCustomProductNames = current.AppConfiguration.UseCustomProductNames,
                ProductNameOverrides = new Dictionary<string, string>(current.AppConfiguration.ProductNameOverrides)
            },
            Api = new ApiOptions
            {
                BaseUrl = current.Api.BaseUrl,
                RequestTimeoutSeconds = current.Api.RequestTimeoutSeconds
            },
            Printer = new PrinterOptions
            {
                Mode = current.Printer.Mode,
                ComPort = current.Printer.ComPort,
                BluetoothAddress = current.Printer.BluetoothAddress,
                BluetoothName = current.Printer.BluetoothName,
                BaudRate = current.Printer.BaudRate,
                DataBits = current.Printer.DataBits,
                StopBits = current.Printer.StopBits,
                Parity = current.Printer.Parity,
                PaperColumns = current.Printer.PaperColumns
            },
            ConsoleLogs = new ConsoleLogOptions
            {
                BasePath = current.ConsoleLogs.BasePath
            }
        };

        ipAddress = settings.GasStationConsole.IpAddress;
        port = settings.GasStationConsole.Port;
        tpv = settings.AppConfiguration.Tpv;
        usuario = settings.AppConfiguration.Usuario;
        tipoVenta = settings.AppConfiguration.TipoVenta;
        tipoInterfaz = settings.AppConfiguration.TipoInterfaz;
        limiteImporte = settings.AppConfiguration.LimiteImporte;
        limiteLitros = settings.AppConfiguration.LimiteLitros;
        cantidadTanqueLleno = settings.AppConfiguration.CantidadTanqueLleno;
        quantityDecimals = settings.AppConfiguration.QuantityDecimals;
        authorizationCountdownSeconds = settings.AppConfiguration.AuthorizationCountdownSeconds;
        historialTopRecords = settings.AppConfiguration.HistorialTopRecords;
        dispenserCount = settings.AppConfiguration.DispenserCount;
        dispenserFillSequential = settings.AppConfiguration.DispenserFillSequential;
        dispenserNumbers = settings.AppConfiguration.DispenserNumbers;
        dispenserLabel = settings.AppConfiguration.DispenserLabel;
        useCustomProductNames = settings.AppConfiguration.UseCustomProductNames;
        productNameOverrides = new Dictionary<string, string>(settings.AppConfiguration.ProductNameOverrides);
        apiRequestTimeoutSeconds = settings.Api.RequestTimeoutSeconds;
        toastDurationMilliseconds = settings.AppConfiguration.ToastDurationMilliseconds;
        databaseIsConnected = ConnectionState.DatabaseIsConnected;
        databaseStatus = ConnectionState.DatabaseStatus;

        printerMode = settings.Printer.Mode;
        printerBaudRate = settings.Printer.BaudRate;
        printerPaperColumns = settings.Printer.PaperColumns;
        printerEndpointId = OperatingSystem.IsWindows()
            ? settings.Printer.ComPort
            : settings.Printer.BluetoothAddress;
        if (!string.IsNullOrWhiteSpace(printerEndpointId))
        {
            // Semilla con lo guardado para que el select muestre la seleccion
            // persistida sin necesidad de re-enumerar.
            printerEndpoints =
            [
                new BluetoothPrinterEndpoint
                {
                    Id = printerEndpointId,
                    DisplayName = OperatingSystem.IsWindows() || string.IsNullOrWhiteSpace(settings.Printer.BluetoothName)
                        ? printerEndpointId
                        : settings.Printer.BluetoothName
                }
            ];
        }

        ParseApiUrl(settings.Api.BaseUrl);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("uaacSetupScrollTopButton");
        }
    }

    private void ParseApiUrl(string url)
    {
        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            apiBaseHost = $"{uri.Scheme}://{uri.Host}";
            apiPort = uri.Port;
        }
        else
        {
            apiBaseHost = url;
            apiPort = 5047;
        }
    }

    private string BuildApiUrl() => $"{apiBaseHost.TrimEnd('/')}:{apiPort}/";

    private async Task SaveConnectOrDisconnectAsync()
    {
        isSaving = true;

        try
        {
            if (ConsoleClient.IsConnected)
            {
                await ConsoleClient.DisconnectAsync();
                connectionStatus = "Desconectado";
                ConnectionState.ResetDatabase();
                SyncDatabaseState();
                ShowToast("Se desconecto correctamente.", true);
                return;
            }

            if (!await SaveConfigurationOnlyAsync())
            {
                return;
            }

            await ConsoleClient.DisconnectAsync();

            var result = await ConsoleClient.ConnectAsync();
            connectionStatus = result.IsAvailable ? "Conectado" : "Sin conexion";

            var databaseResult = await ConsoleClient.CheckDatabaseConnectionAsync();
            ConnectionState.SetDatabaseResult(databaseResult);
            SyncDatabaseState();

            var allConnected = result.IsAvailable && databaseResult.IsSuccess;
            var message = allConnected
                ? "TCP/IP, API y base de datos conectados correctamente."
                : "Revise la conexion TCP/IP, la API o la base de datos.";
            ShowToast(message, allConnected);
        }
        finally
        {
            isSaving = false;
        }
    }


@page "/configuracion"
@inject IAppSettingsService SettingsProvider
@inject IGasStationService ConsoleClient
@inject IConnectionValidationService ConnectionState
@inject NavigationManager NavigationManager

<PageTitle>Configuracion</PageTitle>

<section class="console-shell config-shell">
    <header class="console-header">
        <div>
            <h1>Configuracion</h1>
        </div>
    </header>

    <div class="accordion-list">

        <!-- Interfaz TCP/IP -->
        <section class="accordion-section">
            <button class="accordion-header" type="button" @onclick="() => ToggleSection(0)">
                <div class="accordion-title">
                    <h2>Interfaz TCP/IP</h2>
                    <span class="@GetTcpIndicatorClass()">@GetTcpIndicatorText()</span>
                </div>
                <svg class="accordion-chevron @(openSections[0] ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
            @if (openSections[0])
            {
                <div class="accordion-body">
                    <label class="settings-field">
                        <span>IP destino</span>
                        <input type="text" @bind="ipAddress" placeholder="Ej: 172.20.11.40" />
                    </label>
                    <label class="settings-field">
                        <span>Puerto</span>
                        <input type="number" @bind="port" min="1" max="65535" placeholder="Ej: 8005" />
                    </label>
                </div>
            }
        </section>

        <!-- URL Service -->
        <section class="accordion-section">
            <button class="accordion-header" type="button" @onclick="() => ToggleSection(1)">
                <div class="accordion-title">
                    <h2>URL Service</h2>
                    <span class="@GetDatabaseIndicatorClass()">@GetDatabaseIndicatorText()</span>
                </div>
                <svg class="accordion-chevron @(openSections[1] ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
            @if (openSections[1])
            {
                <div class="accordion-body">
                    <label class="settings-field">
                        <span>Host / URL base</span>
                        <input type="text" @bind="apiBaseHost" placeholder="Ej: http://172.20.11.198" />
                    </label>
                    <label class="settings-field">
                        <span>Puerto API</span>
                        <input type="number" @bind="apiPort" min="1" max="65535" placeholder="Ej: 5047" />
                    </label>
                    <label class="settings-field">
                        <span>Tiempo de espera (seg)</span>
                        <input type="number" @bind="apiRequestTimeoutSeconds" min="1" />
                    </label>
                </div>
            }
        </section>

        <!-- App Configuracion -->
        <section class="accordion-section">
            <button class="accordion-header" type="button" @onclick="() => ToggleSection(2)">
                <div class="accordion-title">
                    <h2>App Configuracion</h2>
                    <span>Datos generales</span>
                </div>
                <svg class="accordion-chevron @(openSections[2] ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
            @if (openSections[2])
            {
                <div class="accordion-body">
                    <label class="settings-field">
                        <span>TPV</span>
                        <input type="number" @bind="tpv" min="1" />
                    </label>
                    <label class="settings-field">
                        <span>Usuario</span>
                        <input type="number" @bind="usuario" min="1" />
                    </label>
                    <label class="settings-field">
                        <span>Tipo de venta</span>
                        <input type="number" @bind="tipoVenta" min="1" />
                    </label>
                    <label class="settings-field">
                        <span>Tipo de interfaz</span>
                        <input type="text" @bind="tipoInterfaz" />
                    </label>
                    <label class="settings-field">
                        <span>Limite de importe</span>
                        <input type="number" @bind="limiteImporte" min="0.01" step="0.01" />
                    </label>
                    <label class="settings-field">
                        <span>Limite de litros</span>
                        <input type="number" @bind="limiteLitros" min="0.01" step="0.01" />
                    </label>
                    <label class="settings-field">
                        <span>Cantidad para tanque lleno</span>
                        <input type="number" @bind="cantidadTanqueLleno" min="0.01" step="0.01" />
                    </label>
                    <label class="settings-field">
                        <span>Decimales de cantidad</span>
                        <input type="number" @bind="quantityDecimals" min="0" max="6" />
                    </label>
                    <label class="settings-field">
                        <span>Tiempo instrucciones (seg)</span>
                        <input type="number" @bind="authorizationCountdownSeconds" min="1" />
                    </label>
                    <label class="settings-field">
                        <span>Cantidad de dispensarios</span>
                        <input type="number" @bind="dispenserCount" min="1" />
                    </label>
                </div>
            }
        </section>

    </div>

    <!-- Botones al fondo -->
    <div class="settings-actions config-actions-footer">
        <button class="btn btn-outline-secondary action-button" type="button" @onclick="OpenTester" disabled="@isSaving">
            Tester
        </button>
        <button class="@GetConnectionButtonClass()" @onclick="SaveConnectOrDisconnectAsync" disabled="@isSaving">
            @GetConnectionButtonText()
        </button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="app-toast @toastCss">@toastMessage</div>
}

@code {
    private AppSettings? settings;
    private string ipAddress = string.Empty;
    private int port;
    private int tpv;
    private int usuario;
    private int tipoVenta;
    private string tipoInterfaz = string.Empty;
    private decimal limiteImporte;
    private decimal limiteLitros;
    private decimal cantidadTanqueLleno;
    private int quantityDecimals;
    private int authorizationCountdownSeconds;
    private int dispenserCount;
    private string apiBaseHost = string.Empty;
    private int apiPort;
    private int apiRequestTimeoutSeconds;
    private int toastDurationMilliseconds;
    private bool isSaving;
    private string connectionStatus = "Sin validar";
    private string databaseStatus = "Sin validar";
    private bool? databaseIsConnected;
    private string? toastMessage;
    private string toastCss = "is-success";

    private readonly bool[] openSections = [false, false, false];

    private void ToggleSection(int index) => openSections[index] = !openSections[index];

    protected override async Task OnInitializedAsync()
    {
        var current = await SettingsProvider.GetSettingsAsync();
        settings = new AppSettings
        {
            GasStationConsole = new GasStationConsoleOptions
            {
                IpAddress = current.GasStationConsole.IpAddress,
                Port = current.GasStationConsole.Port,
                ConnectionTimeoutMilliseconds = current.GasStationConsole.ConnectionTimeoutMilliseconds,
                ReadTimeoutMilliseconds = current.GasStationConsole.ReadTimeoutMilliseconds,
                ReceiveBufferSize = current.GasStationConsole.ReceiveBufferSize,
                MaxSendAttempts = current.GasStationConsole.MaxSendAttempts,
                EncodingName = current.GasStationConsole.EncodingName,
                Commands = new Dictionary<string, string>(current.GasStationConsole.Commands)
            },
            AppConfiguration = new AppConfigurationOptions
            {
                Tpv = current.AppConfiguration.Tpv,
                Usuario = current.AppConfiguration.Usuario,
                TipoVenta = current.AppConfiguration.TipoVenta,
                TipoInterfaz = current.AppConfiguration.TipoInterfaz,
                LimiteImporte = current.AppConfiguration.LimiteImporte,
                LimiteLitros = current.AppConfiguration.LimiteLitros,
                CantidadTanqueLleno = current.AppConfiguration.CantidadTanqueLleno,
                QuantityDecimals = current.AppConfiguration.QuantityDecimals,
                AuthorizationCountdownSeconds = current.AppConfiguration.AuthorizationCountdownSeconds,
                AuthorizationWarningSeconds = current.AppConfiguration.AuthorizationWarningSeconds,
                AuthorizationPollingMilliseconds = current.AppConfiguration.AuthorizationPollingMilliseconds,
                FuelingPollingMilliseconds = current.AppConfiguration.FuelingPollingMilliseconds,
                HoseRestorePollingMilliseconds = current.AppConfiguration.HoseRestorePollingMilliseconds,
                ToastDurationMilliseconds = current.AppConfiguration.ToastDurationMilliseconds,
                DispenserCount = current.AppConfiguration.DispenserCount,
                ConfigurationPasswordHash = current.AppConfiguration.ConfigurationPasswordHash
            },
            Api = new ApiOptions
            {
                BaseUrl = current.Api.BaseUrl,
                RequestTimeoutSeconds = current.Api.RequestTimeoutSeconds
            },
            ConsoleLogs = new ConsoleLogOptions
            {
                BasePath = current.ConsoleLogs.BasePath
            }
        };

        ipAddress = settings.GasStationConsole.IpAddress;
        port = settings.GasStationConsole.Port;
        tpv = settings.AppConfiguration.Tpv;
        usuario = settings.AppConfiguration.Usuario;
        tipoVenta = settings.AppConfiguration.TipoVenta;
        tipoInterfaz = settings.AppConfiguration.TipoInterfaz;
        limiteImporte = settings.AppConfiguration.LimiteImporte;
        limiteLitros = settings.AppConfiguration.LimiteLitros;
        cantidadTanqueLleno = settings.AppConfiguration.CantidadTanqueLleno;
        quantityDecimals = settings.AppConfiguration.QuantityDecimals;
        authorizationCountdownSeconds = settings.AppConfiguration.AuthorizationCountdownSeconds;
        dispenserCount = settings.AppConfiguration.DispenserCount;
        apiRequestTimeoutSeconds = settings.Api.RequestTimeoutSeconds;
        toastDurationMilliseconds = settings.AppConfiguration.ToastDurationMilliseconds;
        databaseIsConnected = ConnectionState.DatabaseIsConnected;
        databaseStatus = ConnectionState.DatabaseStatus;

        ParseApiUrl(settings.Api.BaseUrl);
    }

    private void ParseApiUrl(string url)
    {
        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            apiBaseHost = $"{uri.Scheme}://{uri.Host}";
            apiPort = uri.Port;
        }
        else
        {
            apiBaseHost = url;
            apiPort = 5047;
        }
    }

    private string BuildApiUrl() => $"{apiBaseHost.TrimEnd('/')}:{apiPort}/";

    private async Task SaveConnectOrDisconnectAsync()
    {
        isSaving = true;

        try
        {
            if (ConsoleClient.IsConnected)
            {
                await ConsoleClient.DisconnectAsync();
                connectionStatus = "Desconectado";
                ConnectionState.ResetDatabase();
                SyncDatabaseState();
                ShowToast("Se desconecto correctamente.", true);
                return;
            }

            if (!await SaveConfigurationOnlyAsync())
            {
                return;
            }

            await ConsoleClient.DisconnectAsync();

            var result = await ConsoleClient.ConnectAsync();
            connectionStatus = result.IsAvailable ? "Conectado" : "Sin conexion";

            var databaseResult = await ConsoleClient.CheckDatabaseConnectionAsync();
            ConnectionState.SetDatabaseResult(databaseResult);
            SyncDatabaseState();

            var allConnected = result.IsAvailable && databaseResult.IsSuccess;
            var message = allConnected
                ? "TCP/IP, API y base de datos conectados correctamente."
                : "Revise la conexion TCP/IP, la API o la base de datos.";
            ShowToast(message, allConnected);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenTester()
    {
        NavigationManager.NavigateTo("tester");
    }

    private async Task<bool> SaveConfigurationOnlyAsync()
    {
        if (settings is null || string.IsNullOrWhiteSpace(ipAddress) || port is <= 0 or > 65535)
        {
            ShowToast("Capture una IP y puerto validos.", false);
            return false;
        }

        if (string.IsNullOrWhiteSpace(apiBaseHost) || apiPort is <= 0 or > 65535)
        {
            ShowToast("Capture un host y puerto validos para la API.", false);
            return false;
        }

        var apiUrl = BuildApiUrl();
        if (!Uri.TryCreate(apiUrl, UriKind.Absolute, out var apiUri)
            || (apiUri.Scheme != Uri.UriSchemeHttp && apiUri.Scheme != Uri.UriSchemeHttps))
        {
            ShowToast("Capture una URL valida para LoadManagerApi.", false);
            return false;
        }

        if (tpv <= 0 || usuario <= 0 || tipoVenta <= 0
            || string.IsNullOrWhiteSpace(tipoInterfaz)
            || limiteImporte <= 0 || limiteLitros <= 0 || cantidadTanqueLleno <= 0
            || quantityDecimals is < 0 or > 6
            || authorizationCountdownSeconds <= 0
            || dispenserCount <= 0
            || apiRequestTimeoutSeconds <= 0)
        {
            ShowToast("Revise los valores de configuracion.", false);
            return false;
        }

        settings.GasStationConsole.IpAddress = ipAddress.Trim();
        settings.GasStationConsole.Port = port;
        settings.AppConfiguration.Tpv = tpv;
        settings.AppConfiguration.Usuario = usuario;
        settings.AppConfiguration.TipoVenta = tipoVenta;
        settings.AppConfiguration.TipoInterfaz = tipoInterfaz.Trim();
        settings.AppConfiguration.LimiteImporte = limiteImporte;
        settings.AppConfiguration.LimiteLitros = limiteLitros;
        settings.AppConfiguration.CantidadTanqueLleno = cantidadTanqueLleno;
        settings.AppConfiguration.QuantityDecimals = quantityDecimals;
        settings.AppConfiguration.AuthorizationCountdownSeconds = authorizationCountdownSeconds;
        settings.AppConfiguration.DispenserCount = dispenserCount;
        settings.Api.BaseUrl = apiUrl;
        settings.Api.RequestTimeoutSeconds = apiRequestTimeoutSeconds;

        await SettingsProvider.SaveSettingsAsync(settings);
        return true;
    }

    private string GetConnectionStatus() =>
        ConsoleClient.IsConnected ? "Conectado" : (connectionStatus == "Conectado" ? "Desconectado" : connectionStatus);

    private void SyncDatabaseState()
    {
        databaseIsConnected = ConnectionState.DatabaseIsConnected;
        databaseStatus = ConnectionState.DatabaseStatus;
    }

    private string GetTcpIndicatorText() =>
        ConsoleClient.IsConnected ? "✓ Conectado" : $"✕ {GetConnectionStatus()}";

    private string GetTcpIndicatorClass() =>
        ConsoleClient.IsConnected ? "status-indicator is-success" : "status-indicator is-error";

    private string GetDatabaseIndicatorText()
    {
        if (databaseIsConnected == true) return "✓ Conectado";
        if (databaseIsConnected == false) return "✕ Sin conexion";
        return $"✕ {databaseStatus}";
    }

    private string GetDatabaseIndicatorClass() =>
        databaseIsConnected == true ? "status-indicator is-success" : "status-indicator is-error";

    private string GetConnectionButtonText()
    {
        if (isSaving) return ConsoleClient.IsConnected ? "Desconectando..." : "Guardando...";
        return ConsoleClient.IsConnected ? "Desconectar" : "Guardar y conectar";
    }

    private string GetConnectionButtonClass()
    {
        var colorClass = ConsoleClient.IsConnected ? "btn-outline-danger" : "btn-primary";
        return $"btn {colorClass} action-button settings-save-button";
    }

    private void ShowToast(string message, bool isSuccess)
    {
        toastMessage = message;
        toastCss = isSuccess ? "is-success" : "is-error";
        _ = ClearToastAsync();
    }

    private async Task ClearToastAsync()
    {
        await Task.Delay(toastDurationMilliseconds);
        toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }
}

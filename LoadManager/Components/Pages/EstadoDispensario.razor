@page "/estado-dispensario"
@implements IAsyncDisposable
@using System.Globalization
@using System.Text
@inject IGasStationService ConsoleClient
@inject IAppSettingsService SettingsProvider

<PageTitle>Estado de dispensario</PageTitle>

<section class="console-shell">
    <header class="console-header">
        <div>
            <h1>Estado de dispensario</h1>
        </div>
    </header>

    <section class="dispensers-panel">
        <div class="panel-heading status-panel-heading">
            <h2>Dispensarios</h2>
            <div class="status-query-controls">
                <span>@GetSelectedSummary()</span>
                <button class="btn btn-outline-secondary status-query-button" @onclick="OpenLogsAsync">
                    Logs del dia
                </button>
                <button class="btn btn-outline-secondary status-query-button" @onclick="LoadDispensersFromSummaryAsync" disabled="@isLoadingDispensers">
                    @(isLoadingDispensers ? "Consultando..." : "1.-Consultar dispensarios")
                </button>
                <button class="btn btn-primary status-query-button" @onclick="ConsultSelectedAsync" disabled="@(!CanConsult)">
                    @(isConsulting ? "Consultando..." : "2.-Consultar")
                </button>
            </div>
        </div>

        <div class="dispensers-grid">
            @if (dispensers.Count == 0)
            {
                <p class="empty-message">Consulte dispensarios para seleccionar uno.</p>
            }
            else
            {
                @foreach (var dispenser in dispensers)
                {
                    <button class="dispenser-card @GetDispenserClass(dispenser)"
                            @onclick="() => SelectDispenserAsync(dispenser)">
                        <img src="@dispenser.ImagePath" alt="" />
                        <span class="dispenser-number">@dispenser.Number</span>
                        <span class="dispenser-status">@dispenser.StatusText</span>
                    </button>
                }
            }
        </div>
    </section>

    <section class="tester-panel">
        <div class="panel-heading">
            <h2>Peticion cruda</h2>
            <span>Trama enviada</span>
        </div>

        @if (string.IsNullOrWhiteSpace(lastRequest))
        {
            <p class="empty-message">Sin peticion enviada.</p>
        }
        else
        {
            <div class="raw-response-list raw-request-list">
                <code>@lastRequest</code>
            </div>
        }
    </section>

    <section class="tester-panel">
        <div class="panel-heading response-heading">
            <div>
                <h2>Respuesta cruda</h2>
                <span>Consola</span>
            </div>
            <button class="btn btn-outline-secondary clear-response-button" @onclick="ClearResponse" disabled="@string.IsNullOrWhiteSpace(lastResponse)">
                Limpiar
            </button>
        </div>

        @if (string.IsNullOrWhiteSpace(lastResponse))
        {
            <p class="empty-message">Sin respuesta registrada.</p>
        }
        else
        {
            <div class="raw-response-list">
                <code>@lastResponse</code>
            </div>
        }
    </section>
</section>

@if (showLogsPopup)
{
    <div class="app-modal-backdrop" role="presentation">
        <section class="app-modal" role="dialog" aria-modal="true" aria-labelledby="todayLogsTitle">
            <header class="app-modal-header">
                <div>
                    <h2 id="todayLogsTitle">Logs del dia</h2>
                    <span>@DateTime.Now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                </div>
                <div class="app-modal-actions">
                    <button class="btn btn-outline-secondary clear-response-button" @onclick="LoadTodayLogsAsync" disabled="@isLoadingLogs">
                        @(isLoadingLogs ? "Consultando..." : "Actualizar")
                    </button>
                    <button class="btn btn-outline-danger clear-response-button" @onclick="CloseLogs">
                        Cerrar
                    </button>
                </div>
            </header>

            @if (isLoadingLogs)
            {
                <p class="empty-message">Consultando logs del dia...</p>
            }
            else if (todayLogFiles.Count == 0)
            {
                <p class="empty-message">No hay logs generados para el dia actual.</p>
            }
            else
            {
                <div class="today-log-list">
                    @foreach (var file in todayLogFiles)
                    {
                        <article class="today-log-file">
                            <header>
                                <strong>@file.Title</strong>
                                <span>@file.Path</span>
                            </header>
                            <div class="raw-response-list">
                                <code>@file.Content</code>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
}

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="app-toast @toastCss">@toastMessage</div>
}

@code {
    private const string CheckingImage = "images/dispensers/inactivo.png";
    private const string InactiveImage = "images/dispensers/inactivo.png";
    private const string HoseLiftedImage = "images/dispensers/llamando.png";
    private const string ServingImage = "images/dispensers/sirviendo.png";
    private const string OfflineImage = "images/dispensers/fuera-de-linea.png";

    private readonly CancellationTokenSource pageCancellation = new();
    private readonly List<DispenserStatusViewModel> dispensers = [];
    private readonly List<LogFileViewModel> todayLogFiles = [];
    private bool isConsulting;
    private bool isLoadingDispensers;
    private bool showLogsPopup;
    private bool isLoadingLogs;
    private string? selectedDispenser;
    private string? lastRequest;
    private string? lastResponse;
    private string? toastMessage;
    private string toastCss = "is-success";
    private int toastDurationMilliseconds;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsProvider.GetSettingsAsync(pageCancellation.Token);
        toastDurationMilliseconds = settings.AppConfiguration.ToastDurationMilliseconds;
    }

    private async Task LoadDispensersFromSummaryAsync()
    {
        isLoadingDispensers = true;
        dispensers.Clear();
        selectedDispenser = null;

        try
        {
            var connection = await ConsoleClient.ConnectAsync(pageCancellation.Token);
            if (!connection.IsAvailable)
            {
                ShowToast(connection.UserMessage, false);
                return;
            }

            var result = await ConsoleClient.SendDispenserSummaryAsync(pageCancellation.Token);
            lastRequest = result.RequestFrame;
            lastResponse = !string.IsNullOrWhiteSpace(result.ResponseFrame)
                ? result.ResponseFrame
                : result.UserMessage;

            if (!result.IsSuccess)
            {
                ShowToast(result.UserMessage, false);
                return;
            }

            foreach (var status in DispenserFrameHelper.ParseDispenserSummary(result.ResponseFrame))
            {
                var dispenser = new DispenserStatusViewModel
                {
                    Number = DispenserFrameHelper.NormalizeDispenserNumber(status.Key)
                };

                ApplySummaryStatus(dispenser, status.Value);
                dispensers.Add(dispenser);
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            await ConsoleClient.DisconnectAsync();
            isLoadingDispensers = false;
        }
    }

    private bool CanConsult => !isConsulting && !isLoadingDispensers && !string.IsNullOrWhiteSpace(selectedDispenser);

    private void SelectDispenserAsync(DispenserStatusViewModel dispenser)
    {
        selectedDispenser = dispenser.Number;
    }

    private async Task ConsultSelectedAsync()
    {
        if (!CanConsult)
        {
            return;
        }

        isConsulting = true;
        var dispenser = dispensers.First(item => item.Number == selectedDispenser);
        lastRequest = $"TDE|{DispenserFrameHelper.ToCommandNumber(dispenser.Number)}";
        lastResponse = "Esperando respuesta de la consola...";
        await InvokeAsync(StateHasChanged);

        try
        {
            await ConsoleClient.DisconnectAsync();

            var connection = await ConsoleClient.ConnectAsync(pageCancellation.Token);
            if (!connection.IsAvailable)
            {
                lastResponse = connection.UserMessage;
                ShowToast(connection.UserMessage, connection.IsAvailable);
                return;
            }

            await QueryDispenserAsync(dispenser, lastRequest);
        }
        catch (OperationCanceledException)
        {
            lastResponse = "La consola no respondio dentro del tiempo esperado.";
            ApplyStatus(dispenser, null);
            ShowToast(lastResponse, false);
        }
        finally
        {
            await ConsoleClient.DisconnectAsync();
            isConsulting = false;
        }
    }

    private async Task QueryDispenserAsync(DispenserStatusViewModel dispenser, string requestFrame)
    {
        lastRequest = requestFrame;
        ConsoleCommandResult result;
        try
        {
            result = await ConsoleClient.SendRawFrameAsync(lastRequest, pageCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            lastResponse = "La consola no respondio dentro del tiempo esperado.";
            ApplyStatus(dispenser, null);
            ShowToast(lastResponse, false);
            return;
        }

        lastRequest = string.IsNullOrWhiteSpace(result.RequestFrame) ? lastRequest : result.RequestFrame;
        lastResponse = !string.IsNullOrWhiteSpace(result.ResponseFrame)
            ? result.ResponseFrame
            : result.UserMessage;

        if (result.IsSuccess)
        {
            ApplyStatus(dispenser, result.ResponseFrame);
        }
        else
        {
            ApplyStatus(dispenser, null);
        }

        ShowToast(result.UserMessage, result.IsSuccess);
    }

    private void ClearResponse()
    {
        lastRequest = null;
        lastResponse = null;
    }

    private async Task OpenLogsAsync()
    {
        showLogsPopup = true;
        await LoadTodayLogsAsync();
    }

    private void CloseLogs()
    {
        showLogsPopup = false;
    }

    private async Task LoadTodayLogsAsync()
    {
        isLoadingLogs = true;
        todayLogFiles.Clear();

        try
        {
            var settings = await SettingsProvider.GetSettingsAsync(pageCancellation.Token);
            var options = settings.ConsoleLogs;
            var today = DateTime.Now;
            var basePath = Path.IsPathRooted(options.BasePath)
                ? options.BasePath
                : Path.Combine(AppContext.BaseDirectory, options.BasePath);

            await LoadLogFolderAsync(basePath, today);
            todayLogFiles.Sort((left, right) => right.LastWriteTime.CompareTo(left.LastWriteTime));
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isLoadingLogs = false;
        }
    }

    private async Task LoadLogFolderAsync(string basePath, DateTime date)
    {
        var folderPath = Path.Combine(
            basePath,
            date.ToString("yyyy", CultureInfo.InvariantCulture),
            date.ToString("MM", CultureInfo.InvariantCulture),
            date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));

        if (!Directory.Exists(folderPath))
        {
            return;
        }

        foreach (var filePath in Directory.GetFiles(folderPath, "*.txt").OrderByDescending(File.GetLastWriteTime))
        {
            var content = await File.ReadAllTextAsync(filePath, Encoding.UTF8, pageCancellation.Token);
            var lastWriteTime = File.GetLastWriteTime(filePath);
            todayLogFiles.Add(new LogFileViewModel(
                Path.GetFileName(filePath),
                filePath,
                string.IsNullOrWhiteSpace(content) ? "(archivo sin contenido)" : FormatNewestLogEntriesFirst(content),
                lastWriteTime));
        }
    }

    private static string FormatNewestLogEntriesFirst(string content)
    {
        var lines = content
            .Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Reverse();

        return string.Join(Environment.NewLine, lines);
    }

    private static void ApplyStatus(DispenserStatusViewModel dispenser, string? response)
    {
        dispenser.LastResponse = response;
        var statusCode = DispenserFrameHelper.TryParseDetailStatus(response);
        dispenser.StatusCode = statusCode ?? string.Empty;

        switch (statusCode)
        {
            case "2":
                dispenser.StatusText = "Disponible";
                dispenser.ImagePath = InactiveImage;
                break;
            case "3":
                dispenser.StatusText = "Manguera levantada";
                dispenser.ImagePath = HoseLiftedImage;
                break;
            case "4":
                dispenser.StatusText = "Surtiendo";
                dispenser.ImagePath = ServingImage;
                break;
            default:
                dispenser.StatusText = string.IsNullOrWhiteSpace(statusCode) ? "Sin respuesta" : $"Estatus {statusCode}";
                dispenser.ImagePath = OfflineImage;
                break;
        }
    }

    private static void ApplySummaryStatus(DispenserStatusViewModel dispenser, string? statusCode)
    {
        dispenser.LastResponse = statusCode;
        dispenser.StatusCode = statusCode ?? string.Empty;

        switch (statusCode)
        {
            case "1":
                dispenser.StatusText = "Libre";
                dispenser.ImagePath = InactiveImage;
                break;
            case "2":
                dispenser.StatusText = "Disponible";
                dispenser.ImagePath = InactiveImage;
                break;
            case "3":
                dispenser.StatusText = "Manguera levantada";
                dispenser.ImagePath = HoseLiftedImage;
                break;
            case "4":
                dispenser.StatusText = "Surtiendo";
                dispenser.ImagePath = ServingImage;
                break;
            default:
                dispenser.StatusText = string.IsNullOrWhiteSpace(statusCode) ? "Sin respuesta" : $"Estatus {statusCode}";
                dispenser.ImagePath = OfflineImage;
                break;
        }
    }

    private string GetDispenserClass(DispenserStatusViewModel dispenser)
    {
        var classes = new List<string>();

        classes.Add(dispenser.StatusCode switch
        {
            "2" => "is-authorized",
            "3" => "is-hose-lifted",
            "4" => "is-serving",
            _ => "is-checking"
        });

        if (selectedDispenser == dispenser.Number)
        {
            classes.Add("is-selected");
        }

        return string.Join(" ", classes);
    }

    private string GetSelectedSummary()
    {
        return string.IsNullOrWhiteSpace(selectedDispenser)
            ? "Seleccione dispensario"
            : $"Seleccionado {selectedDispenser}";
    }

    private string GetRawRequestText()
    {
        return string.IsNullOrWhiteSpace(lastRequest) ? "Sin peticion enviada." : lastRequest;
    }

    private string GetRawResponseText()
    {
        return string.IsNullOrWhiteSpace(lastResponse) ? "Sin respuesta registrada." : lastResponse;
    }

    private void ShowToast(string message, bool isSuccess)
    {
        toastMessage = message;
        toastCss = isSuccess ? "is-success" : "is-error";
        _ = ClearToastAsync();
    }

    private async Task ClearToastAsync()
    {
        try
        {
            await Task.Delay(toastDurationMilliseconds, pageCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await pageCancellation.CancelAsync();
        pageCancellation.Dispose();
    }

}

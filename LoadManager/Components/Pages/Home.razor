        }

        return string.Empty;
    }

    private string GetSelectedStatusClass()
    {
        if (SelectedDispenser is null)
        {
            return "is-checking";
        }

        if (SelectedDispenser.StatusCode == "3")
        {
            return "is-hose-lifted";
        }

        if (SelectedDispenser.StatusCode == "2")

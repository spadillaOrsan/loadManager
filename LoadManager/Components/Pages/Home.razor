    // Porcentaje de avance del surtido (0-100) para la simulacion del tanque.
    // Devuelve null cuando no hay meta definida (despacho "Lleno") y no aplica.
    private int? FuelProgressPercent
    {
        get
        {
            if (SelectedDispatchType?.IsFull == true)
            {
                return null;
            }

            if (!TryGetAmount(out var requested) || requested <= 0)
            {
                return null;
            }

            var current = SelectedDispatchType?.IsMoney == true ? liveAmount : liveLiters;
            var pct = (int)Math.Floor(current / requested * 100m);
            return Math.Clamp(pct, 0, 100);
        }
    }


@page "/"
@page "/despacho"
@implements IAsyncDisposable
@using System.Globalization
@inject IGasStationService ConsoleClient
@inject IAppSettingsService SettingsProvider
@inject IConnectionValidationService ConnectionState
@inject IDevModeService DevMode
@inject IActiveDispatchTracker DispatchTracker
@inject ISimulatedDispatchHistoryStore SimulatedHistory
@inject IReceiptPrinterService ReceiptPrinter
@inject IConsoleLogService Logger
@inject IJSRuntime JsRuntime
@inject LoadManager.Services.ModuleHeaderState HeaderState

<section class="console-shell">

    <nav class="dispatch-stepper" aria-label="Progreso del despacho">
        @for (var i = 0; i < steps.Count; i++)
        {
            var step = steps[i];
            <div class="dispatch-step @GetStepClass(step.Index)">
                <span class="step-marker">@(i + 1)</span>
                <span class="step-label">@step.Name</span>
            </div>
        }
    </nav>

    @if (currentStep == 2)
    {
        <div class="selection-workspace @(IsSelectionWorkspaceLoading || isDispatching ? "is-loading" : string.Empty)" aria-busy="@(IsSelectionWorkspaceLoading || isDispatching)">
            <div class="dispatch-stage-track stage-@dispatchFormStage">
                <section class="dispensers-panel dispatch-stage-card">
                    @if (dispensers.Count == 0)
                    {
                        <p class="empty-message">No hay @dispenserLabel disponibles para operar.</p>
                    }
                    else
                    {
                        <div class="dispensers-grid">
                            @foreach (var dispenser in dispensers)
                            {
                                <button class="dispenser-card @GetDispenserClass(dispenser)"
                                        @onclick="() => SelectDispenserAsync(dispenser)"
                                        disabled="@(IsSelectionWorkspaceLoading || isDispatching || !CanSelectDispenser(dispenser))">
                                    <img src="@dispenser.ImagePath" alt="" />
                                    <div class="dispenser-text">
                                        <span class="dispenser-number">@dispenserLabel @dispenser.Number</span>
                                        <span class="dispenser-status">@dispenser.StatusText</span>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </section>

                <section class="fuel-panel dispatch-stage-card">
                    <div class="fuel-options">
                        @foreach (var product in products)
                        {
                            <button class="fuel-option @product.CssClass @(selectedProductKey == product.Key ? "is-selected" : string.Empty)"
                                    @onclick="() => SelectProduct(product)"
                                    disabled="@(IsSelectionWorkspaceLoading || isDispatching || !CanEditSelectedDispenser)">
                                <img src="@product.ImagePath" alt="" />
                                <span class="fuel-option-text">
                                    <strong>@product.Name</strong>
                                    <small>@GetProductPriceText(product)</small>
                                </span>
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(productLoadMessage))
                    {
                        <p class="empty-message">@productLoadMessage</p>
                    }
                </section>

                <section class="quantity-panel dispatch-stage-card">
                    @if (SelectedProduct is not null)
                    {
                        <div class="amount-mode-group" role="group" aria-label="Tipo de carga">
                            @if (isLoadingDispatchTypes)
                            {
                                <button class="amount-mode is-selected" disabled>
                                    Consultando tipos de despacho...
                                </button>
                            }
                            else
                            {
                                @foreach (var dispatchType in dispatchTypes)
                                {
                                    <button class="amount-mode dispatch-type-button @(selectedDispatchTypeId == dispatchType.Id ? "is-selected" : string.Empty)"
                                            @onclick="() => SelectDispatchTypeAndAdvance(dispatchType)"
                                            disabled="@(!CanEditSelectedDispenser || isDispatching)">
                                        @if (dispatchType.IsMoney)
                                        {
                                            <svg class="amount-mode-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <circle cx="12" cy="12" r="9" />
                                                <path d="M12 6v12" />
                                                <path d="M15 9.5c0-1.4-1.3-2.5-3-2.5s-3 1-3 2.3c0 3 6 1.3 6 4.2 0 1.3-1.3 2.5-3 2.5s-3-1.1-3-2.5" />
                                            </svg>
                                        }
                                        else if (dispatchType.IsVolume)
                                        {
                                            <svg class="amount-mode-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M12 3s-6 7.4-6 11.5A6 6 0 0 0 18 14.5C18 10.4 12 3 12 3Z" />
                                            </svg>
                                        }
                                        else if (dispatchType.IsFull)
                                        {
                                            <svg class="amount-mode-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <rect x="2" y="8" width="20" height="8" rx="2" />
                                                <text x="12" y="14.2" text-anchor="middle" font-size="6.5" font-weight="800" style="fill:currentColor;stroke:none;">9999</text>
                                            </svg>
                                        }
                                        @dispatchType.Description
                                    </button>
                                }
                            }
                        </div>

                        @if (!isLoadingDispatchTypes && dispatchTypes.Count == 0)
                        {
                            <p class="empty-message">No se encontraron tipos de despacho activos.</p>
                        }
                    }
                </section>

                <section class="amount-panel dispatch-stage-card">
                    @if (SelectedDispatchType?.IsFull != true)
                    {
                        <div class="amount-input-row">
                            <label class="amount-input-wrap">
                                <div class="amount-input">
                                    @if (SelectedDispatchType?.IsMoney == true)
                                    {
                                        <strong>$</strong>
                                    }
                                    <input type="text"
                                           @key="amountInputRenderKey"
                                           inputmode="decimal"
                                           maxlength="12"
                                           placeholder="0.00"
                                           value="@amountValue"
                                           @oninput="OnAmountChanged"
                                           @onfocus="TouchKeyboardHelper.Show"
                                           @onblur="FormatAmount"
                                           disabled="@(!CanEditSelectedDispenser || isDispatching)" />
                                    @if (SelectedDispatchType?.IsVolume == true)
                                    {
                                        <strong>Lt</strong>
                                    }
                                </div>
                            </label>
                            <button class="btn btn-outline-secondary icon-only-button"
                                    type="button"
                                    title="Borrar monto"
                                    aria-label="Borrar monto"
                                    @onclick="ClearAmountInput"
                                    disabled="@isDispatching">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M3 6h18" />
                                    <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2" />
                                    <path d="M19 6l-1 14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 6" />
                                    <path d="M10 11v6M14 11v6" />
                                </svg>
                            </button>
                        </div>

                        <div class="amount-mode-group quick-amount-group" role="group" aria-label="Montos rapidos">
                            @foreach (var preset in VisibleQuickAmountPresets)
                            {
                                <button type="button" class="amount-mode quick-amount-button"
                                        @onclick="() => SelectQuickAmount(preset)"
                                        disabled="@(!CanEditSelectedDispenser || isDispatching)">
                                    @GetQuickAmountLabel(preset)
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="full-charge-note">Se surtira hasta llenar el tanque.</p>
                    }

                    <div class="charge-circle-wrap">
                        <button class="charge-circle" @onclick="StartDispatchAsync" disabled="@(!CanServe)">
                            <span class="charge-circle-text">@(isDispatching ? "..." : "Cargar")</span>
                        </button>
                    </div>
                </section>
            </div>

            @if (IsSelectionWorkspaceLoading)
            {
                <div class="selection-loading" role="status">
                    <span class="loading-spinner" aria-hidden="true"></span>
                    <strong>@GetSelectionLoadingText()</strong>
                </div>
            }
        </div>

    }
    else if (currentStep == 3)
    {
        <section class="authorization-panel">
            @if (currentDispatchFolio is int dispatchFolio)
            {
                <div class="dispatch-folio-banner"><strong>#@dispatchFolio</strong></div>
            }

            <div class="ticket-grid dispatch-summary-grid">
                <div>
                    <span>@dispenserLabel</span>
                    <strong>@selectedDispenser</strong>
                </div>
                <div>
                    <span>Producto</span>
                    <strong>@SelectedProduct?.Name</strong>
                </div>
                <div>
                    <span>Precio</span>
                    <strong>@GetDispatchSummaryPriceText()</strong>
                </div>
                <div>
                    <span>Cantidad</span>
                    <strong>@GetDispatchSummaryAmount()</strong>
                </div>
            </div>

            @if (isFueling)
            {
                @if (!string.IsNullOrEmpty(GetAuthorizationStepTitle()))
                {
                    <div class="dispatch-progress-status">
                        <h2>@GetAuthorizationStepTitle()</h2>
                        <span>@GetAuthorizationStepStatus()</span>
                    </div>
                }

                @if (DevMode.ShouldShowLiveCounter)
                {
                    <div class="liters-display" aria-live="polite">
                        <span class="live-counter-status">Surtiendo</span>
                        <span>@GetPrimaryLiveCounterLabel()</span>
                        <strong>@((MarkupString)FormatPrimaryLiveCounter())</strong>
                        <div class="live-secondary-counter">
                            <span>@GetSecondaryLiveCounterLabel()</span>
                            <strong>@((MarkupString)FormatSecondaryLiveCounter())</strong>
                        </div>
                    </div>
                }

                @if (FuelProgressPercent is int tankPct)
                {
                    <div class="fuel-tank @FuelTankColorClass @(tankPct >= 100 ? "is-complete" : null)"
                         role="img" aria-label="@($"Llenado {tankPct} por ciento")">
                        <svg class="fuel-tank-svg" viewBox="0 0 160 110" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <clipPath id="fuelCanClip">
                                    <rect x="12" y="18" width="136" height="68" rx="34" />
                                </clipPath>
                            </defs>
                            <rect x="36" y="82" width="13" height="20" rx="2" fill="#cdd9e5" />
                            <rect x="111" y="82" width="13" height="20" rx="2" fill="#cdd9e5" />
                            <rect x="68" y="7" width="24" height="13" rx="2" fill="#cdd9e5" stroke="#a9bccd" stroke-width="2" />
                            <rect x="12" y="18" width="136" height="68" rx="34" fill="#eaf0f6" />
                            <rect class="fuel-tank-liquid" x="12" width="136"
                                  y="@(86 - 68 * tankPct / 100)" height="@(68 * tankPct / 100)"
                                  clip-path="url(#fuelCanClip)" />
                            <rect x="12" y="18" width="136" height="68" rx="34" fill="none" stroke="#a9bccd" stroke-width="3" />
                        </svg>
                        <span class="fuel-tank-pct">@tankPct<small>%</small></span>
                    </div>
                    <div class="fuel-tank-preset">
                        <span class="fuel-tank-preset-label">Preset</span>
                        <strong>@((MarkupString)FormatPresetValue())</strong>
                    </div>
                    @if (DevMode.ShouldShowCancelDispatchButton && !isWaitingForDispatchHoseHang && !isCancelingAuthorization)
                    {
                        <button type="button" class="btn btn-outline-danger cancel-dispatch-button"
                                @onclick="CancelActiveDispatchManuallyAsync"
                                disabled="@isCancelingAuthorization">
                            Cancelar carga
                        </button>
                    }
                }
            }
            else
            {
                @if (DevMode.ShouldShowCountdown)
                {
                    <div class="countdown-display" role="timer" aria-live="polite">
                        <strong>@remainingAuthorizationSeconds</strong>
                        <span>segundos</span>
                    </div>
                }

                <article class="instruction-card instruction-card-single">
                    <div class="instruction-item">
                        <span>1</span>
                        <strong>Descuelga la manguera</strong>
                    </div>
                    <div class="instruction-item">
                        <span>2</span>
                        <strong>Coloque en el tanque</strong>
                    </div>
                    <div class="instruction-item">
                        <span>3</span>
                        <strong>Presione gatillo</strong>
                    </div>
                </article>
            }
        </section>
    }
    else if (currentStep == 4)
    {
        <section class="authorization-panel @(isPrintingTicket ? "is-printing" : string.Empty)">
            @if (dispatchTicket is not null)
            {
                <div class="ticket-panel">
                    <div class="liters-display is-finished" aria-live="polite">
                        <span class="live-counter-status">Terminado</span>
                        <span>@GetPrimaryLiveCounterLabel()</span>
                        <strong>@((MarkupString)FormatPrimaryLiveCounter())</strong>
                        <div class="live-secondary-counter">
                            <span>@GetSecondaryLiveCounterLabel()</span>
                            <strong>@((MarkupString)FormatSecondaryLiveCounter())</strong>
                        </div>
                    </div>

                    <div class="ticket-folio">
                        <span>Folio</span>
                        <strong>@dispatchTicket.Folio</strong>
                    </div>

                    <div class="ticket-grid">
                        <div>
                            <span>@dispenserLabel</span>
                            <strong>#@dispatchTicket.Dispenser</strong>
                        </div>
                        <div>
                            <span>Manguera</span>
                            <strong>@dispatchTicket.Hose</strong>
                        </div>
                        <div>
                            <span>Producto</span>
                            <strong>@dispatchTicket.Product</strong>
                        </div>
                        <div>
                            <span>Tipo</span>
                            <strong>@dispatchTicket.DispatchType</strong>
                        </div>
                        <div>
                            <span>Cantidad</span>
                            <strong>@dispatchTicket.ProgrammedAmount</strong>
                        </div>
                        <div>
                            <span>Precio</span>
                            <strong>@($"${dispatchTicket.Price:N2}")</strong>
                        </div>
                        <div>
                            <span>Litros</span>
                            <strong>@(dispatchTicket.Liters + " Lt")</strong>
                        </div>
                        <div>
                            <span>Importe</span>
                            <strong>@($"${dispatchTicket.Amount:N2}")</strong>
                        </div>
                    </div>

                    <div class="ticket-actions">
                        @if (!DevMode.IsPrintButtonHidden)
                        {
                            <button class="btn btn-outline-secondary action-button" @onclick="PrintTicketAsync" disabled="@isPrintingTicket">
                                Imprimir ticket
                            </button>
                        }
                        <button class="btn btn-primary action-button ticket-home-button" @onclick="ReturnToStart" disabled="@isPrintingTicket">
                            Volver a inicio
                        </button>
                    </div>
                </div>
            }

            @if (isPrintingTicket)
            {
                <div class="selection-loading" role="status">
                    <span class="loading-spinner" aria-hidden="true"></span>
                    <strong>Imprimiendo ticket...</strong>
                </div>
            }
        </section>
    }
</section>

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="app-toast @toastCss">@toastMessage</div>
}

@if (isHoseLiftedBlockVisible)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert light-status-modal" role="alertdialog" aria-modal="true" aria-live="assertive">
            <div class="hose-alert-icon">!</div>
            <h2>Favor de colgar la manguera</h2>
            <p>@hoseLiftedBlockMessage</p>
            <span>La pantalla se habilitara automaticamente cuando el @dispenserLabel vuelva a disponible.</span>
        </section>
    </div>
}

@if (isDispatching)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert light-status-modal" role="alertdialog" aria-modal="true" aria-live="assertive">
            <span class="loading-spinner" aria-hidden="true"></span>
            <h2>Enviando peticion</h2>
            <p>Espere un momento...</p>
            <div class="ticket-grid dispatch-summary-grid dispatch-summary-grid-modal">
                <div>
                    <span>@dispenserLabel</span>
                    <strong>@selectedDispenser</strong>
                </div>
                <div>
                    <span>Producto</span>
                    <strong>@SelectedProduct?.Name</strong>
                </div>
                <div>
                    <span>Precio</span>
                    <strong>@GetDispatchSummaryPriceText()</strong>
                </div>
                <div>
                    <span>Cantidad</span>
                    <strong>@GetDispatchSummaryAmount()</strong>
                </div>
            </div>
            <span>Los campos permaneceran bloqueados hasta recibir respuesta.</span>
        </section>
    </div>
}

@if (isCancelingAuthorization)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert" role="alertdialog" aria-modal="true" aria-live="assertive">
            <span class="loading-spinner" aria-hidden="true"></span>
            <h2>@cancelingAuthorizationTitle</h2>
            <p>@cancelingAuthorizationMessage</p>
            <span>La pantalla permanecera bloqueada hasta terminar.</span>
        </section>
    </div>
}

@if (isWaitingForDispatchHoseHang)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert light-status-modal" role="alertdialog" aria-modal="true" aria-live="assertive">
            <div class="hose-alert-icon">!</div>
            <h2>Favor de colgar la manguera</h2>
            <p>Carga finalizada.</p>
            <span>Cuelgue la manguera para continuar y ver los detalles de la carga.</span>
        </section>
    </div>
}

@if (isStartingFlow)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert light-status-modal" role="alertdialog" aria-modal="true" aria-live="assertive">
            <span class="loading-spinner" aria-hidden="true"></span>
            <h2>Iniciando modulo</h2>
            <p>@(string.IsNullOrWhiteSpace(startupStatusMessage) ? "Espere un momento..." : startupStatusMessage)</p>
            <span>La pantalla permanecera bloqueada hasta terminar la validacion.</span>
        </section>
    </div>
}

@* COMENTADO: modal dispositivo no autorizado
@if (deviceNotAuthorized)
{
    <div class="app-modal-backdrop blocking-alert-backdrop">
        <section class="app-modal hose-alert device-unauthorized" role="alertdialog" aria-modal="true" aria-live="assertive">
            <div class="device-unauthorized-bell" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9Z" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
            </div>
            <h2>DISPOSITIVO NO AUTORIZADO</h2>
            <p>Revisar con el dpto. correspondiente.</p>
            <span>La aplicacion se cerrara en @deviceAuthRemainingSeconds segundos.</span>
        </section>
    </div>
}
*@

@if (connectionBlocked && !isStartingFlow)
{
    <div class="app-modal-backdrop blocking-alert-backdrop connection-block-backdrop">
        <section class="app-modal hose-alert" role="alertdialog" aria-modal="true" aria-live="assertive">
            <div class="hose-alert-icon">!</div>
            <h2>Sin comunicacion</h2>
            <p>@connectionBlockedMessage</p>
            <span>Revise que los dispositivos se encuentren conectados y la configuracion correctamente. Use el menu para ir a Configuracion.</span>
            <div class="settings-actions" style="margin-top:1rem;">
                <button class="btn btn-primary action-button" @onclick="RetryConnectionAsync">
                    Reintentar
                </button>
            </div>
        </section>
    </div>
}

@code {
    private RenderFragment DispatchHeaderActions => @<text>
        @if (currentStep == 2)
        {
            @if (!DevMode.BypassDispenserCommunication)
            {
                <button class="btn btn-outline-secondary icon-only-button"
                        type="button"
                        title="Refrescar"
                        aria-label="Refrescar"
                        @onclick="RefreshConfiguredDispensersAsync"
                        disabled="@(isLoadingDispensers || isDispatching)">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M21 12a9 9 0 1 1-3-6.7" />
                        <path d="M21 3v6h-6" />
                    </svg>
                </button>
            }
            @if (dispatchFormStage >= 2)
            {
                <button class="btn btn-outline-secondary icon-only-button"
                        type="button"
                        title="Volver"
                        aria-label="Volver"
                        @onclick="GoBack"
                        disabled="@isDispatching">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 12H5" />
                        <path d="M11 18l-6-6 6-6" />
                    </svg>
                </button>
            }
        }
    </text>;
}

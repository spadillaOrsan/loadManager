    private void ShowToast(string message, bool isSuccess)
    {
        ShowToast(message, isSuccess ? "is-success" : "is-error");
    }

    private void ShowToast(string message, string cssClass)
    {
        var version = ++toastVersion;
        toastMessage = message;
        toastCss = cssClass;
        _ = ClearToastAsync(version);
    }

    private void ShowInfoToast(string message)
    {
        ShowToast(message, "is-info");
    }

    private static (string Message, bool IsSuccess) GetAuthorizationToastMessage(ConsoleCommandResult result)
    {
        var responseFrame = result.ResponseFrame ?? string.Empty;
        if (responseFrame.Contains("NoAutorizado", StringComparison.OrdinalIgnoreCase) ||
            responseFrame.Contains("No autorizado", StringComparison.OrdinalIgnoreCase))
        {
            return ($"No autorizado: {responseFrame}", false);
        }

        if (responseFrame.Contains("Autorizado", StringComparison.OrdinalIgnoreCase))
        {
            return ($"Autorizado: {responseFrame}", true);
        }

        if (!result.IsSuccess)
        {
            return (result.UserMessage, false);
        }

        return (string.IsNullOrWhiteSpace(responseFrame)
            ? result.UserMessage
            : responseFrame, result.IsSuccess);
    }

    private async Task ClearToastAsync(int version)
    {
        try
        {
            await Task.Delay(3500, pageCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (version != toastVersion)
        {
            return;
        }

        toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await pageCancellation.CancelAsync();
        pageCancellation.Dispose();
        dispatchCancellation?.Dispose();
    }


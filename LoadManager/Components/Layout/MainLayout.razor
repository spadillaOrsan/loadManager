@inherits LayoutComponentBase
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="page @CurrentThemeClass">
    <div class="sidebar">
        @if (IsThemeToggleEnabled)
        {
            <button class="theme-toggle-button sidebar-theme-toggle"
                    type="button"
                    title="Cambiar tema"
                    aria-label="Cambiar tema"
                    @onclick="ToggleTheme">
                @if (themeIndex == 0)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3 4.5 16h15L12 3Z" />
                        <path d="M8 21h8" />
                    </svg>
                }
                else if (themeIndex == 1)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5Z" />
                    </svg>
                }
            </button>
        }
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @if (!string.IsNullOrWhiteSpace(CurrentModuleTitle))
            {
                <header class="console-header module-header">
                    <h1>@CurrentModuleTitle</h1>
                </header>
            }
            @Body
        </article>
    </main>
</div>


@code {
    private const bool IsThemeToggleEnabled = false;

    private int themeIndex = 2;

    private string CurrentThemeClass => themeIndex switch
    {
        1 => "theme-light",
        2 => "theme-dark",
        3 => "theme-black",
        _ => "theme-red"
    };

    private void ToggleTheme()
    {
        themeIndex = (themeIndex + 1) % 4;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("uaacHideKeyboardOnEnter");
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    // Titulo de modulo mostrado arriba del contenido, calculado por ruta. Solo
    // cubre pantallas que no tienen su propio <h1> (Despacho/Historial); las que
    // ya tienen uno propio (Configuracion, Estado de dispensario, Tester) quedan
    // afuera para no duplicarlo.
    private string CurrentModuleTitle
    {
        get
        {
            var path = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
            return path switch
            {
                "" or "despacho" => "Despacho",
                "historial" => "Historial",
                _ => string.Empty
            };
        }
    }
}

@inherits LayoutComponentBase
@inject IJSRuntime JsRuntime

<div class="page @CurrentThemeClass">
    <div class="sidebar">
        <button class="theme-toggle-button sidebar-theme-toggle"
                type="button"
                title="Cambiar tema"
                aria-label="Cambiar tema"
                @onclick="ToggleTheme">
            @if (themeIndex == 0)
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3 4.5 16h15L12 3Z" />
                    <path d="M8 21h8" />
                </svg>
            }
            else if (themeIndex == 1)
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
            }
            else if (themeIndex == 2)
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5Z" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="8" />
                    <path d="M12 4a8 8 0 0 1 0 16Z" />
                </svg>
            }
        </button>
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (showWelcome)
{
    <div class="entry-screen">
        <button class="entry-dispenser" type="button" @onclick="EnterApplicationAsync" aria-label="Entrar a UAAC"></button>
    </div>
}

@code {
    private static bool hasEnteredApplication;
    private int themeIndex;
    private bool showWelcome = !hasEnteredApplication;

    private string CurrentThemeClass => themeIndex switch
    {
        1 => "theme-light",
        2 => "theme-dark",
        3 => "theme-black",
        _ => "theme-red"
    };

    private void ToggleTheme()
    {
        themeIndex = (themeIndex + 1) % 4;
    }

    private async Task EnterApplicationAsync()
    {
        await JsRuntime.InvokeVoidAsync("uaacPlayEntryClick");
        hasEnteredApplication = true;
        showWelcome = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("uaacHideKeyboardOnEnter");
        }
    }
}

@inherits LayoutComponentBase
@inject IJSRuntime JsRuntime

<div class="page @CurrentThemeClass">
    <div class="sidebar">
        <button class="theme-toggle-button sidebar-theme-toggle"
                type="button"
                title="Cambiar tema"
                aria-label="Cambiar tema"
                @onclick="ToggleTheme">
            @if (themeIndex == 0)
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3 4.5 16h15L12 3Z" />
                    <path d="M8 21h8" />
                </svg>
            }
            else if (themeIndex == 1)
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5Z" />
                </svg>
            }
        </button>
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (showWelcome)
{
    <div class="entry-screen">
        <button class="entry-dispenser" type="button" @onclick="EnterApplicationAsync" aria-label="Entrar a UAAC">
            <svg viewBox="0 0 180 210" aria-hidden="true">
                <path d="M25 198h92v-19c0-9-7-16-16-16h-7V28c0-12-10-22-22-22H52C40 6 30 16 30 28v135h-7c-9 0-16 7-16 16v19z" />
                <rect x="47" y="27" width="31" height="30" rx="4" />
                <circle cx="63" cy="96" r="24" />
                <path class="drop" d="M63 69c-13 19-19 30-19 40 0 11 8 19 19 19s19-8 19-19c0-10-6-21-19-40z" />
                <path class="hose" d="M94 81h24c18 0 33 15 33 33v40c0 13-10 23-23 23s-23-10-23-23V58" />
                <path class="nozzle" d="M105 58l-20-20c-5-5-5-12 0-17s12-5 17 0l20 20c5 5 5 12 0 17s-12 5-17 0z" />
            </svg>
        </button>
        <img class="entry-brand-image" src="images/ua2.png" alt="Ultra Access" />
        <strong>Administrador de cargas</strong>
    </div>
}

@code {
    private static bool hasEnteredApplication;
    private int themeIndex;
    private bool showWelcome = !hasEnteredApplication;

    private string CurrentThemeClass => themeIndex switch
    {
        1 => "theme-light",
        2 => "theme-dark",
        _ => "theme-red"
    };

    private void ToggleTheme()
    {
        themeIndex = (themeIndex + 1) % 3;
    }

    private async Task EnterApplicationAsync()
    {
        await JsRuntime.InvokeVoidAsync("uaacPlayEntryClick");
        hasEnteredApplication = true;
        showWelcome = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("uaacHideKeyboardOnEnter");
        }
    }
}

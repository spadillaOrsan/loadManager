@inherits LayoutComponentBase
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject LoadManager.Services.ModuleHeaderState HeaderState
@inject LoadManager.Services.Interfaces.IDevModeService DevMode
@implements IDisposable

<div class="page @CurrentThemeClass">
    <div class="sidebar">
        @if (DevMode.IsThemeButtonVisible)
        {
            <button class="theme-toggle-button sidebar-theme-toggle"
                    type="button"
                    title="Cambiar tema"
                    aria-label="Cambiar tema"
                    @onclick="ToggleTheme">
                @if (themeIndex == 0)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3 4.5 16h15L12 3Z" />
                        <path d="M8 21h8" />
                    </svg>
                }
                else if (themeIndex == 1)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                    </svg>
                }
                else if (themeIndex == 4)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5Z" />
                    </svg>
                }
            </button>
        }
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @if (!string.IsNullOrWhiteSpace(CurrentModuleTitle))
            {
                <header class="console-header module-header">
                    <div class="module-header-title-group">
                        <h1>@CurrentModuleTitle</h1>
                        @if (HeaderState.Subtitle is not null)
                        {
                            <p class="module-header-subtitle">@HeaderState.Subtitle</p>
                        }
                    </div>
                    @if (HeaderState.Actions is not null)
                    {
                        <div class="module-header-actions">
                            @HeaderState.Actions
                        </div>
                    }
                </header>
            }
            @Body
        </article>
    </main>
</div>


@code {
    private int themeIndex = 4;

    private string CurrentThemeClass => themeIndex switch
    {
        1 => "theme-light",
        2 => "theme-dark",
        3 => "theme-black",
        4 => "theme-dark theme-dispensers-white",
        _ => "theme-red"
    };

    private void ToggleTheme()
    {
        themeIndex = (themeIndex + 1) % 5;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("uaacHideKeyboardOnEnter");
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        HeaderState.Changed += OnHeaderStateChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnHeaderStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        HeaderState.Changed -= OnHeaderStateChanged;
    }

    // Titulo de modulo mostrado arriba del contenido, calculado por ruta. Solo
    // cubre pantallas que no tienen su propio <h1> (Despacho/Historial); las que
    // ya tienen uno propio (Configuracion, Estado de dispensario, Tester) quedan
    // afuera para no duplicarlo.
    private string CurrentModuleTitle
    {
        get
        {
            var path = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
            return path switch
            {
                "" or "despacho" => "Despacho",
                "historial" => "Historial",
                _ => string.Empty
            };
        }
    }
}

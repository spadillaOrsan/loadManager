@inject NavigationManager NavigationManager
@inject IAppSettingsService SettingsProvider
@inject IActiveDispatchTracker DispatchTracker
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @if (IsDispatchActive)
        {
            <span class="navbar-brand">Administrador de cargas</span>
        }
        else
        {
            <a class="navbar-brand" href="">Administrador de cargas</a>
        }
    </div>
</div>

<input type="checkbox" id="nav-menu-toggle" title="Navigation menu" class="navbar-toggler"
       disabled="@IsDispatchActive" />
<label for="nav-menu-toggle" class="navbar-toggler-button @(IsDispatchActive ? "is-disabled" : string.Empty)"
       aria-label="Abrir menu" aria-disabled="@IsDispatchActive">
    <span></span>
    <span></span>
    <span></span>
</label>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="despacho">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 20V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v15" />
                    <path d="M3 20h15" />
                    <path d="M8 7h5v5H8z" />
                    <path d="M16 8h2l2 2v7a2 2 0 0 1-4 0v-4" />
                </svg>
                Despacho
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="historial">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 3h8l2 2v16H6V5l2-2Z" />
                    <path d="M9 8h6" />
                    <path d="M9 12h6" />
                    <path d="M9 16h4" />
                </svg>
                Historial
            </NavLink>
        </div>
    </nav>

    <button class="nav-settings-button" type="button" @onclick="OpenConfigurationGate" title="Configuracion">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1A2 2 0 1 1 4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1A2 2 0 1 1 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1A2 2 0 1 1 19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.1a2 2 0 1 1 0 4H21a1.7 1.7 0 0 0-1.6 1Z" />
        </svg>
        <span>Configuracion</span>
    </button>
</div>

@if (showConfigurationGate)
{
    <div class="app-modal-backdrop">
        <section class="app-modal config-gate" role="dialog" aria-modal="true">
            <header>
                <h2>Acceso a configuracion</h2>
                <p>Ingrese la contraseña para continuar.</p>
            </header>

            <EditForm Model="this" OnSubmit="ValidateConfigurationPasswordAsync">
                <label class="settings-field">
                    <span>Contraseña</span>
                    <div class="password-input-wrap">
                        <input type="@(showConfigurationPassword ? "text" : "password")"
                               @bind="configurationPassword"
                               autocomplete="current-password" />
                        <button type="button"
                                class="password-toggle-button"
                                title="@(showConfigurationPassword ? "Ocultar contraseña" : "Mostrar contraseña")"
                                @onclick="ToggleConfigurationPasswordVisibility">
                            @if (showConfigurationPassword)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <path d="m1 1 22 22" />
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            }
                        </button>
                    </div>
                </label>

                @if (!string.IsNullOrWhiteSpace(configurationError))
                {
                    <p class="config-gate-error">@configurationError</p>
                }

                <div class="config-gate-actions">
                    <button class="btn btn-outline-danger action-button" type="button" @onclick="CloseConfigurationGate">
                        Cancelar
                    </button>
                    <button class="btn btn-primary action-button" type="submit">
                        Entrar
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    private bool IsDispatchActive => DispatchTracker.ActiveDispenser is not null;

    protected override void OnInitialized()
    {
        DispatchTracker.StateChanged += OnTrackerStateChanged;
    }

    private void OnTrackerStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DispatchTracker.StateChanged -= OnTrackerStateChanged;
    }

    private bool showConfigurationGate;
    private bool showConfigurationPassword;
    private string configurationPassword = string.Empty;
    private string? configurationError;

    private void ToggleConfigurationPasswordVisibility()
    {
        showConfigurationPassword = !showConfigurationPassword;
    }

    private void OpenConfigurationGate()
    {
        configurationPassword = string.Empty;
        showConfigurationPassword = false;
        configurationError = null;
        showConfigurationGate = true;
    }

    private void CloseConfigurationGate()
    {
        showConfigurationGate = false;
        configurationPassword = string.Empty;
        configurationError = null;
    }

    private async Task ValidateConfigurationPasswordAsync()
    {
        var settings = await SettingsProvider.GetSettingsAsync();
        if (!AppSettingsCryptoHelper.VerifyConfigurationPassword(
            settings.AppConfiguration.ConfigurationPasswordHash,
            configurationPassword))
        {
            configurationError = "Contraseña incorrecta.";
            return;
        }

        CloseConfigurationGate();
        NavigationManager.NavigateTo("configuracion");
    }
}
